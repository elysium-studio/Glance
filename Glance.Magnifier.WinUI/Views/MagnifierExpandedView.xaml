<UserControl
    x:Class="Glance.Magnifier.WinUI.MagnifierExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Magnifier.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceMagnifierIconBrush}"
                Glyph="&#xE8A3;" />
        </Grid>
        <Grid
            Grid.Column="1"
            Height="58"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="22" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceMagnifierIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(Title)}" />
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                AutomationProperties.Name="{x:Bind StartLabel}"
                Click="{x:Bind ViewModel.Start}"
                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind StartLabel}"
                Visibility="{x:Bind WhenStopped(ViewModel.IsRunning), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Setter Property="Content" Value="&#xE768;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind ZoomOutLabel}"
                Click="{x:Bind ViewModel.ZoomOut}"
                IsEnabled="{x:Bind ViewModel.CanZoomOut, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ZoomOutLabel}"
                Visibility="{x:Bind WhenRunning(ViewModel.IsRunning), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Setter Property="Content" Value="&#xE738;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind ZoomInLabel}"
                Click="{x:Bind ViewModel.ZoomIn}"
                IsEnabled="{x:Bind ViewModel.CanZoomIn, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ZoomInLabel}"
                Visibility="{x:Bind WhenRunning(ViewModel.IsRunning), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Setter Property="Content" Value="&#xE710;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind CloseLabel}"
                Click="{x:Bind ViewModel.Close}"
                IsEnabled="{x:Bind ViewModel.CanClose, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind CloseLabel}"
                Visibility="{x:Bind WhenRunning(ViewModel.IsRunning), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Content" Value="&#xE711;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
