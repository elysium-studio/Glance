<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GlanceMagnifierIconBrush" Color="#FF7BDFF2" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF7BDFF2" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E67BDFF2" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CC7BDFF2" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlanceMagnifierIconBrush" Color="#FF006B80" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF006B80" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E6006B80" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CC006B80" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="GlanceMagnifierIconBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="SystemColorButtonFaceColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
