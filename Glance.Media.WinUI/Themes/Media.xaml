<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GlanceMediaIconBrush" Color="#FF8A65" />
            <SolidColorBrush x:Key="GlanceMediaAmbientBaseBrush" Color="#FF1C1E24" />
            <LinearGradientBrush x:Key="GlanceMediaAmbientTintBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#E60E131E" />
                <GradientStop Offset="0.58" Color="#DE151A27" />
                <GradientStop Offset="1" Color="#D6261A22" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFFF8A65" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E6FF8A65" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CCFF8A65" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlanceMediaIconBrush" Color="#B23A1D" />
            <SolidColorBrush x:Key="GlanceMediaAmbientBaseBrush" Color="#FFF2F2F2" />
            <LinearGradientBrush x:Key="GlanceMediaAmbientTintBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#EDFFFFFF" />
                <GradientStop Offset="0.58" Color="#E5FFFDFC" />
                <GradientStop Offset="1" Color="#DCFFF2ED" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFB23A1D" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E6B23A1D" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CCB23A1D" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="GlanceMediaIconBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="GlanceMediaAmbientBaseBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="GlanceMediaAmbientTintBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="SystemColorButtonFaceColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
