<UserControl
    x:Class="Glance.Media.WinUI.MediaExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:Local="using:Glance.Media.WinUI">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Media.xaml" />
    </UserControl.Resources>
    <Grid>
        <Local:MediaAlbumAmbience ViewModel="{x:Bind ViewModel}" />
        <Grid Padding="20,12,20,26" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="ArtworkContainer"
                Width="64"
                Height="64"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{ThemeResource GlanceMediaIconBrush}"
                        Glyph="&#xE8D6;"
                        Visibility="{x:Bind WhenArtworkUnavailable(ViewModel.Artwork), Mode=OneWay}" />
                    <Local:MediaArtworkTransition Source="{x:Bind ToImageSource(ViewModel.Artwork), Mode=OneWay}" />
                </Grid>
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GlanceMediaIconBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ToUpper(ViewModel.Source), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Controls:MarqueeTextBlock
                    Height="24"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}"
                    Visibility="{x:Bind WhenAvailable(ViewModel.HasSession), Mode=OneWay}" />
                <Controls:MarqueeTextBlock
                    Height="16"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Artist, Mode=OneWay}"
                    Visibility="{x:Bind WhenAvailable(ViewModel.HasSession), Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind WhenUnavailable(ViewModel.HasSession), Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind WhenUnavailable(ViewModel.HasSession), Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Spacing="4">
                <Local:MediaAudioVisualizer
                    Width="23"
                    Height="16"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind WhenAvailable(ViewModel.ShowAudioVisualization), Mode=OneWay}"
                    ViewModel="{x:Bind ViewModel}" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="5">
                    <Button
                        x:Uid="PreviousButton"
                        Click="{x:Bind ViewModel.Previous}"
                        IsEnabled="{x:Bind ViewModel.CanSkipPrevious, Mode=OneWay}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                <Setter Property="Width" Value="32" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Content" Value="&#xE622;" />
                                <Setter Property="CornerRadius" Value="16" />
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                <Setter Property="FontSize" Value="14" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        x:Uid="ToggleButton"
                        Click="{x:Bind ViewModel.TogglePlayback}"
                        Content="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanTogglePlayback, Mode=OneWay}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                                <Setter Property="Width" Value="36" />
                                <Setter Property="Height" Value="36" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="18" />
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                <Setter Property="FontSize" Value="16" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        x:Uid="NextButton"
                        Click="{x:Bind ViewModel.Next}"
                        IsEnabled="{x:Bind ViewModel.CanSkipNext, Mode=OneWay}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                <Setter Property="Width" Value="32" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Content" Value="&#xE623;" />
                                <Setter Property="CornerRadius" Value="16" />
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                <Setter Property="FontSize" Value="14" />
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
