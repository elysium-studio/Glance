<UserControl
    x:Class="Glance.Media.WinUI.MediaCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="using:Glance.UI.WinUI"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:Local="using:Glance.Media.WinUI"
    Loaded="{x:Bind HandleLoaded}"
    Unloaded="{x:Bind HandleUnloaded}">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Media.xaml" />
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Padding="12,4" ColumnSpacing="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompactSizeStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Standard">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger MinHeight="33" MaxHeight="48" Source="{x:Bind LayoutRoot, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="10,2" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="7" />
                        <Setter Target="ArtworkContainer.Width" Value="22" />
                        <Setter Target="ArtworkContainer.Height" Value="22" />
                        <Setter Target="ArtworkContainer.CornerRadius" Value="5.5" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger
                            MaxHeight="32"
                            Source="{x:Bind LayoutRoot, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="8,0,8,4" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="6" />
                         <Setter Target="TitleText.FontSize" Value="12" />
                        <Setter Target="TitleText.FontWeight" Value="Normal" />
                        <Setter Target="ArtworkContainer.Width" Value="18" />
                        <Setter Target="ArtworkContainer.Height" Value="18" />
                        <Setter Target="ArtworkContainer.Margin" Value="0,1,0,-1" />
                        <Setter Target="ArtworkContainer.CornerRadius" Value="4.5" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="ArtworkContainer"
            Width="28"
            Height="28"
            CornerRadius="7">
            <Grid>
                <Border
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="7"
                    Visibility="{x:Bind WhenArtworkUnavailable(ViewModel.Artwork), Mode=OneWay}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{ThemeResource GlanceMediaIconBrush}"
                        Glyph="&#xE8D6;" />
                </Border>
                <Local:MediaArtworkTransition Source="{x:Bind ToImageSource(ViewModel.Artwork), Mode=OneWay}" />
            </Grid>
        </Border>
        <Controls:MarqueeTextBlock
            x:Name="TitleText"
            Grid.Column="1"
            Height="20"
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" />
        <Local:MediaAudioVisualizer
            Grid.Column="2"
            Width="23"
            Height="18"
            AccentColor="{x:Bind ViewModel.AccentColor, Mode=OneWay}"
            Margin="4,0,4,0"
            VerticalAlignment="Center"
            Visibility="{x:Bind WhenAvailable(ViewModel.ShowAudioVisualization), Mode=OneWay}"
            ViewModel="{x:Bind ViewModel}" />
    </Grid>
</UserControl>
