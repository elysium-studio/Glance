<UserControl
    x:Class="Glance.Media.WinUI.MediaArtworkTransition"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Loaded="{x:Bind HandleLoaded}"
    SizeChanged="{x:Bind HandleSizeChanged}"
    Unloaded="{x:Bind HandleUnloaded}">
    <Grid x:Name="PerspectiveLayer">
        <Image
            x:Name="PrimaryArtwork"
            Opacity="0"
            Stretch="UniformToFill"
            Translation="0,0,8">
            <Image.Shadow>
                <ThemeShadow />
            </Image.Shadow>
        </Image>
        <Image
            x:Name="SecondaryArtwork"
            Opacity="0"
            Stretch="UniformToFill"
            Translation="0,0,8">
            <Image.Shadow>
                <ThemeShadow />
            </Image.Shadow>
        </Image>
    </Grid>
</UserControl>
