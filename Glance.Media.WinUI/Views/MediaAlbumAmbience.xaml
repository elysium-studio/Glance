<UserControl
    x:Class="Glance.Media.WinUI.MediaAlbumAmbience"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Loaded="{x:Bind HandleLoaded}"
    Opacity="0"
    SizeChanged="{x:Bind HandleSizeChanged}"
    Unloaded="{x:Bind HandleUnloaded}">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Media.xaml" />
    </UserControl.Resources>
    <Border Background="Transparent" CornerRadius="28">
        <Grid>
            <Grid x:Name="MotionLayer">
                <Grid x:Name="ArtworkHost" />
            </Grid>
            <Rectangle Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        </Grid>
    </Border>
</UserControl>
