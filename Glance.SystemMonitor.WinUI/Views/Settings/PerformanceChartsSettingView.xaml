<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.SystemMonitor.WinUI.PerformanceChartsSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="PerformanceChartsSettingCard">
        <CommunityToolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE9D2;" />
        </CommunityToolkit:SettingsCard.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.Value, Mode=TwoWay}" />
    </CommunityToolkit:SettingsCard>
</UserControl>
