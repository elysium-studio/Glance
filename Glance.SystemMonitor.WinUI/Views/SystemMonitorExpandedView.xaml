<UserControl
    x:Class="Glance.SystemMonitor.WinUI.SystemMonitorExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glance.SystemMonitor.WinUI">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/System.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,30" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceSystemIconBrush}"
                Glyph="&#xEEA1;" />
        </Grid>
        <Grid Grid.Column="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="CpuMetric"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <local:SystemMetricGraph
                        x:Name="CpuGraph"
                        Margin="6,26,6,6"
                        GridStroke="{ThemeResource GlanceSystemGraphGridBrush}"
                        PrimaryStroke="{ThemeResource GlanceSystemCpuGraphBrush}"
                        Visibility="{x:Bind WhenShowingCharts(ShowPerformanceCharts), Mode=OneWay}" />
                    <StackPanel
                        Margin="8,6"
                        Spacing="1"
                        Visibility="{x:Bind WhenShowingCharts(ShowPerformanceCharts), Mode=OneWay}">
                        <TextBlock
                            x:Uid="CpuLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemCpuGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Margin="8,6"
                        VerticalAlignment="Center"
                        Spacing="3"
                        Visibility="{x:Bind WhenHidingCharts(ShowPerformanceCharts), Mode=OneWay}">
                        <TextBlock
                            x:Uid="CpuLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemCpuGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" />
                        <ProgressBar
                            Height="3"
                            Foreground="{ThemeResource GlanceSystemCpuGraphBrush}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.CpuUsage, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border
                x:Name="MemoryMetric"
                Grid.Column="1"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <local:SystemMetricGraph
                        x:Name="MemoryGraph"
                        Margin="6,26,6,6"
                        GridStroke="{ThemeResource GlanceSystemGraphGridBrush}"
                        PrimaryStroke="{ThemeResource GlanceSystemMemoryGraphBrush}"
                        Visibility="{x:Bind WhenShowingCharts(ShowPerformanceCharts), Mode=OneWay}" />
                    <StackPanel
                        Margin="8,6"
                        Spacing="1"
                        Visibility="{x:Bind WhenShowingCharts(ShowPerformanceCharts), Mode=OneWay}">
                        <TextBlock
                            x:Uid="RamLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemMemoryGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Margin="8,6"
                        VerticalAlignment="Center"
                        Spacing="3"
                        Visibility="{x:Bind WhenHidingCharts(ShowPerformanceCharts), Mode=OneWay}">
                        <TextBlock
                            x:Uid="RamLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemMemoryGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                        <ProgressBar
                            Height="3"
                            Foreground="{ThemeResource GlanceSystemMemoryGraphBrush}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.MemoryUsage, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border
                x:Name="GpuMetric"
                Grid.Column="2"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <local:SystemMetricGraph
                        x:Name="GpuGraph"
                        Margin="6,26,6,6"
                        GridStroke="{ThemeResource GlanceSystemGraphGridBrush}"
                        PrimaryStroke="{ThemeResource GlanceSystemGpuGraphBrush}"
                        Visibility="{x:Bind WhenShowingCharts(ShowPerformanceCharts), Mode=OneWay}" />
                    <StackPanel
                        Margin="8,6"
                        Spacing="1"
                        Visibility="{x:Bind WhenShowingCharts(ShowPerformanceCharts), Mode=OneWay}">
                        <TextBlock
                            x:Uid="GpuLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemGpuGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.GpuText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Margin="8,6"
                        VerticalAlignment="Center"
                        Spacing="3"
                        Visibility="{x:Bind WhenHidingCharts(ShowPerformanceCharts), Mode=OneWay}">
                        <TextBlock
                            x:Uid="GpuLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemGpuGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.GpuText, Mode=OneWay}" />
                        <ProgressBar
                            Height="3"
                            Foreground="{ThemeResource GlanceSystemGpuGraphBrush}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.GpuUsage, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
