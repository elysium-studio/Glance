<UserControl
    x:Class="Glance.SystemMonitor.WinUI.SystemMonitorExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glance.SystemMonitor.WinUI">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/System.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,10,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceSystemIconBrush}"
                Glyph="&#xEEA1;" />
        </Grid>
        <Grid Grid.Column="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="CpuMetric"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <local:SystemMetricGraph
                        x:Name="CpuGraph"
                        Margin="6,26,6,6"
                        GridStroke="{ThemeResource GlanceSystemGraphGridBrush}"
                        PrimaryStroke="{ThemeResource GlanceSystemCpuGraphBrush}" />
                    <StackPanel Margin="8,6" Spacing="1">
                        <TextBlock
                            x:Uid="ProcessorLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemCpuGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border
                x:Name="MemoryMetric"
                Grid.Column="1"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <local:SystemMetricGraph
                        x:Name="MemoryGraph"
                        Margin="6,26,6,6"
                        GridStroke="{ThemeResource GlanceSystemGraphGridBrush}"
                        PrimaryStroke="{ThemeResource GlanceSystemMemoryGraphBrush}" />
                    <StackPanel Margin="8,6" Spacing="1">
                        <TextBlock
                            x:Uid="MemoryLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemMemoryGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border
                x:Name="NetworkMetric"
                Grid.Column="2"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <local:SystemMetricGraph
                        x:Name="NetworkGraph"
                        Margin="6,26,6,6"
                        GridStroke="{ThemeResource GlanceSystemGraphGridBrush}"
                        Maximum="0"
                        PrimaryStroke="{ThemeResource GlanceSystemNetworkDownloadGraphBrush}"
                        SecondaryStroke="{ThemeResource GlanceSystemNetworkUploadGraphBrush}" />
                    <Grid Margin="8,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="NetworkLabel"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlanceSystemNetworkDownloadGraphBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="3">
                            <FontIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource GlanceSystemNetworkDownloadGraphBrush}"
                                Glyph="&#xE74B;" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.DownloadText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="3">
                            <FontIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource GlanceSystemNetworkUploadGraphBrush}"
                                Glyph="&#xE74A;" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.UploadText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
