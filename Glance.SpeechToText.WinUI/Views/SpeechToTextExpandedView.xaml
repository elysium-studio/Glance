<UserControl
    x:Class="Glance.SpeechToText.WinUI.SpeechToTextExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/SpeechToText.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceSpeechToTextIconBrush}"
                Glyph="&#xE720;" />
        </Grid>
        <Grid
            Grid.Column="1"
            Height="58"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceSpeechToTextIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(Title)}" />
            <TextBlock
                Grid.Row="1"
                Margin="0,2,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.ExpandedStatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{x:Bind ViewModel.Transcript, Mode=OneWay}">
                <TextBlock.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="ClearMenuItem"
                            Click="{x:Bind ViewModel.Clear}"
                            Icon="Delete" />
                    </MenuFlyout>
                </TextBlock.ContextFlyout>
            </TextBlock>
        </Grid>
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Uid="AudioSourceButton"
                IsEnabled="{x:Bind CanChangeAudioSource(ViewModel.IsListening, ViewModel.IsBusy), Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.AudioSourceLabel, Mode=OneWay}"
                Visibility="{x:Bind ToReadyVisibility(ViewModel.Availability), Mode=OneWay}">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <ToggleMenuFlyoutItem
                            x:Uid="MeetingSourceMenuItem"
                            Click="{x:Bind ViewModel.SelectMeeting}"
                            IsChecked="{x:Bind IsMeetingSource(ViewModel.SelectedAudioSource), Mode=OneWay}" />
                        <ToggleMenuFlyoutItem
                            x:Uid="MicrophoneSourceMenuItem"
                            Click="{x:Bind ViewModel.SelectMicrophone}"
                            IsChecked="{x:Bind IsMicrophoneSource(ViewModel.SelectedAudioSource), Mode=OneWay}" />
                        <ToggleMenuFlyoutItem
                            x:Uid="SystemAudioSourceMenuItem"
                            Click="{x:Bind ViewModel.SelectSystemAudio}"
                            IsChecked="{x:Bind IsSystemAudioSource(ViewModel.SelectedAudioSource), Mode=OneWay}" />
                    </MenuFlyout>
                </Button.Flyout>
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Content" Value="&#xE8D6;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
            <Button
                x:Uid="CopyButton"
                Click="{x:Bind ViewModel.Copy}"
                Visibility="{x:Bind ToTranscriptVisibility(ViewModel.HasTranscript), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Content" Value="&#xE8C8;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
            <Button
                x:Uid="DownloadModelButton"
                Click="{x:Bind DownloadModel}"
                IsEnabled="{x:Bind CanDownloadModel(ViewModel.IsBusy), Mode=OneWay}"
                Visibility="{x:Bind ToModelRequiredVisibility(ViewModel.Availability), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Setter Property="Content" Value="&#xE896;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>
                </Button.Style>
            </Button>
            <Button
                x:Uid="ListeningButton"
                Click="{x:Bind ViewModel.ToggleListening}"
                Content="{x:Bind ViewModel.ToggleGlyph, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanToggleListening, Mode=OneWay}"
                Visibility="{x:Bind ToReadyVisibility(ViewModel.Availability), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
