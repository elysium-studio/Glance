<UserControl
    x:Class="Glance.SpeechToText.WinUI.SpeechToTextExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/SpeechToText.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="StatusIndicator" Width="36" Height="36" VerticalAlignment="Center">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceSpeechToTextIconBrush}"
                Glyph="&#xE720;" />
        </Grid>
        <Grid Grid.Column="1" Height="58" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="22" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceSpeechToTextIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Title}" />
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind ViewModel.MainText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap">
                <TextBlock.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="CopyTranscriptMenuItem" Click="{x:Bind CopyTranscript}" Icon="Copy" />
                        <MenuFlyoutItem x:Uid="ClearTranscriptMenuItem" Click="{x:Bind ClearTranscript}" Icon="Clear" />
                    </MenuFlyout>
                </TextBlock.ContextFlyout>
            </TextBlock>
            <TextBlock
                Grid.Row="2"
                Height="16"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>
        <Button
            x:Name="AudioSourceButton"
            Grid.Column="2"
            Width="36"
            Height="36"
            Padding="0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind ViewModel.AudioSourceName, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanChangeAudioSource, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind ViewModel.AudioSourceName, Mode=OneWay}">
            <Button.Flyout>
                <MenuFlyout x:Name="AudioSourceFlyout" Opening="HandleAudioSourceFlyoutOpening" Opened="HandleAudioSourceFlyoutOpened" Closed="HandleAudioSourceFlyoutClosed" />
            </Button.Flyout>
            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE767;" />
        </Button>
        <Button
            Grid.Column="3"
            Width="36"
            Height="36"
            Padding="0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind ViewModel.ToggleToolTip, Mode=OneWay}"
            Content="{x:Bind ViewModel.ToggleGlyph, Mode=OneWay}"
            FontFamily="Segoe Fluent Icons"
            FontSize="16"
            IsEnabled="{x:Bind ViewModel.CanToggleListening, Mode=OneWay}"
            Click="{x:Bind ToggleListening}"
            Style="{StaticResource AccentButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.ToggleToolTip, Mode=OneWay}" />
    </Grid>
</UserControl>
