<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Loaded="{x:Bind HandleLoaded}"
    SizeChanged="{x:Bind HandleSizeChanged}"
    Unloaded="{x:Bind HandleUnloaded}">
    <Border
        x:Name="SceneRoot"
        Background="#FF1A2940"
        CornerRadius="28">
        <Grid>
            <Grid x:Name="BackgroundHost" />
            <Grid x:Name="ParticleHost" />
            <Grid x:Name="CloudLayerHost" />
            <Canvas x:Name="LightningHost" />
            <Rectangle Fill="#26071324" />
            <Rectangle Opacity="0.22" Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        </Grid>
    </Border>
</UserControl>
