<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Loaded="{x:Bind HandleLoaded}"
    SizeChanged="{x:Bind HandleSizeChanged}"
    Unloaded="{x:Bind HandleUnloaded}">
    <Border
        x:Name="SceneRoot"
        Background="#FF1A2940"
        CornerRadius="28">
        <Grid>
            <Grid x:Name="ParticleHost" />
            <Canvas x:Name="CloudHost" />
            <Path
                x:Name="LightningBolt"
                Width="56"
                Height="76"
                Margin="0,4,66,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Data="M34,0 L8,42 L27,42 L18,76 L50,30 L31,30 Z"
                Fill="#FFF8DD78"
                Opacity="0"
                Stretch="Fill"
                Visibility="Collapsed" />
            <Rectangle Fill="#26071324" />
            <Rectangle Opacity="0.22" Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        </Grid>
    </Border>
</UserControl>
