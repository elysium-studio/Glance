<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherTemperaturePreviewSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="WeatherTemperaturePreviewSettingCard">
        <ComboBox
            Width="240"
            SelectedIndex="{x:Bind ViewModel.Value, Mode=TwoWay}">
            <ComboBoxItem x:Uid="WeatherPreviewLiveOption" />
            <ComboBoxItem x:Uid="WeatherTemperatureNormalOption" />
            <ComboBoxItem x:Uid="WeatherSceneHotOption" />
        </ComboBox>
    </CommunityToolkit:SettingsCard>
</UserControl>
