<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherLocationSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="WeatherLocationSettingCard">
        <StackPanel Width="240" Spacing="8">
            <TextBox
                x:Uid="WeatherLocationTextBox"
                HorizontalAlignment="Stretch"
                Text="{x:Bind ViewModel.Value, Mode=TwoWay}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasValidationError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>
    </CommunityToolkit:SettingsCard>
</UserControl>
