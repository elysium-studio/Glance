<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherApiKeySettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <StackPanel Spacing="4">
        <CommunityToolkit:SettingsCard x:Uid="WeatherApiKeySettingCard">
            <CommunityToolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8D7;" />
            </CommunityToolkit:SettingsCard.HeaderIcon>
            <PasswordBox
                Width="240"
                HorizontalAlignment="Stretch"
                Password="{x:Bind ViewModel.Value, Mode=TwoWay}"
                PasswordRevealMode="Peek" />
        </CommunityToolkit:SettingsCard>
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasValidationError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
            Severity="Warning" />
    </StackPanel>
</UserControl>
