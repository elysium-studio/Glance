<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherUnitsSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="WeatherUnitsSettingCard">
        <CommunityToolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE9CA;" />
        </CommunityToolkit:SettingsCard.HeaderIcon>
        <ComboBox
            Width="240"
            SelectedIndex="{x:Bind ViewModel.Value, Mode=TwoWay}">
            <ComboBoxItem x:Uid="WeatherCelsiusOption" />
            <ComboBoxItem x:Uid="WeatherFahrenheitOption" />
        </ComboBox>
    </CommunityToolkit:SettingsCard>
</UserControl>
