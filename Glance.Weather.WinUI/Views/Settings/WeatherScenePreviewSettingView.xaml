<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherScenePreviewSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="WeatherTimePreviewSettingCard">
        <ComboBox
            Width="240"
            SelectedIndex="{x:Bind ViewModel.Value, Mode=TwoWay}">
            <ComboBoxItem x:Uid="WeatherPreviewLiveOption" />
            <ComboBoxItem x:Uid="WeatherTimeDawnOption" />
            <ComboBoxItem x:Uid="WeatherTimeMorningOption" />
            <ComboBoxItem x:Uid="WeatherTimeAfternoonOption" />
            <ComboBoxItem x:Uid="WeatherTimeEveningOption" />
            <ComboBoxItem x:Uid="WeatherTimeDuskOption" />
            <ComboBoxItem x:Uid="WeatherTimeNightOption" />
        </ComboBox>
    </CommunityToolkit:SettingsCard>
</UserControl>
