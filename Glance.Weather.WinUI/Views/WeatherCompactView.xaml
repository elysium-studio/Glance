<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Weather.xaml" />
    </UserControl.Resources>
    <Grid Padding="14,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="28"
            Height="28">
            <Path
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{x:Bind ToGeometry(ViewModel.IconPath), Mode=OneWay}"
                Fill="{x:Bind ToBrush(ViewModel.AccentColor), Mode=OneWay}"
                Style="{StaticResource GlanceWeatherIconPathStyle}" />
        </Grid>
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            MaxLines="1"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.CompactStatusText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
