<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Weather.WinUI.WeatherExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Weather.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,10,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center"
            FontFamily="Segoe Fluent Icons"
            FontSize="32"
            Foreground="{ThemeResource GlanceWeatherAccentBrush}"
            Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock
                Foreground="{ThemeResource GlanceWeatherAccentBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(ViewModel.Title)}" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                ToolTipService.ToolTip="{x:Bind ViewModel.StatisticsText, Mode=OneWay}"
                Visibility="{x:Bind WhenHasWeather(ViewModel.HasWeatherData), Mode=OneWay}">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.ConditionText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.LocationText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind WhenHasWeather(ViewModel.HasWeatherData), Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.ConditionText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind WhenMissingWeather(ViewModel.HasWeatherData), Mode=OneWay}" />
            <TextBlock
                MaxWidth="220"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="{x:Bind WhenMissingWeather(ViewModel.HasWeatherData), Mode=OneWay}" />
        </StackPanel>
        <Button
            Grid.Column="2"
            AutomationProperties.Name="{x:Bind ViewModel.RefreshLabel}"
            Click="{x:Bind Refresh}"
            ToolTipService.ToolTip="{x:Bind ViewModel.RefreshLabel}">
            <Button.Style>
                <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="18" />
                    <Setter Property="Content" Value="&#xE72C;" />
                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
