<UserControl
    x:Class="Glance.WorldClock.WinUI.WorldClockExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:WorldClock="using:Glance.WorldClock">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/WorldClock.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="WorldClockItemTemplate" x:DataType="WorldClock:WorldClockItemViewModel">
                <StackPanel Margin="2,0,0,0" VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind TimeText, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DisplayName}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="&#x2022;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DateText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceWorldClockIconBrush}"
                Glyph="&#xE121;" />
        </Grid>
        <Grid
            Grid.Column="1"
            Height="64"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceWorldClockIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(Title)}" />
            <Controls:CompactFlipView
                Grid.Row="1"
                Margin="-22,0,0,0"
                Background="Transparent"
                ItemTemplate="{StaticResource WorldClockItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Clocks}"
                SelectedItem="{x:Bind ViewModel.SelectedClock, Mode=TwoWay}" />
        </Grid>
    </Grid>
</UserControl>
