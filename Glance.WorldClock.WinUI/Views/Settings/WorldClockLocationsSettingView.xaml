<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.WorldClock.WinUI.WorldClockLocationsSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Glance.WorldClock.WinUI">
    <CommunityToolkit:SettingsCard x:Uid="WorldClockLocationsSettingCard">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="TimeZonePicker"
                    x:Uid="WorldClockTimeZonePicker"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind ViewModel.AvailableTimeZones}"
                    SelectedItem="{x:Bind ViewModel.SelectedTimeZone, Mode=TwoWay}" />
                <Button
                    x:Name="AddClockButton"
                    x:Uid="WorldClockAddButton"
                    Grid.Column="1"
                    Click="HandleAddClockClicked"
                    IsEnabled="{x:Bind ViewModel.CanAddClock, Mode=OneWay}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Content" Value="&#xE710;" />
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <ListView
                x:Name="ClockList"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="HandleClocksReordered"
                ItemsSource="{x:Bind ViewModel.Clocks}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WorldClockTimeZoneOption">
                        <Grid MinHeight="44" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Glyph="&#xF772;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind DisplayName}" />
                            <Button
                                x:Uid="WorldClockRemoveButton"
                                Grid.Column="2"
                                Click="HandleRemoveClockClicked"
                                Tag="{x:Bind}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                        <Setter Property="Width" Value="36" />
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Content" Value="&#xE74D;" />
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </CommunityToolkit:SettingsCard>
</UserControl>
