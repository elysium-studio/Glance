<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.WorldClock.WinUI.WorldClockLocationsSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid>
        <CommunityToolkit:SettingsCard
            x:Uid="WorldClockLocationsSettingCard"
            Visibility="{x:Bind WhenEmpty(ViewModel.HasClocks), Mode=OneWay}">
            <Button
                x:Uid="WorldClockAddButton"
                Click="HandleAddClockClicked">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Content" Value="&#xE710;" />
                    </Style>
                </Button.Style>
            </Button>
        </CommunityToolkit:SettingsCard>
        <CommunityToolkit:SettingsExpander
            x:Uid="WorldClockLocationsSettingCard"
            IsExpanded="True"
            ItemsSource="{x:Bind ViewModel.Clocks}"
            Visibility="{x:Bind WhenPopulated(ViewModel.HasClocks), Mode=OneWay}">
            <CommunityToolkit:SettingsExpander.Content>
                <Button
                    x:Uid="WorldClockAddButton"
                    Click="HandleAddClockClicked">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Content" Value="&#xE710;" />
                        </Style>
                    </Button.Style>
                </Button>
            </CommunityToolkit:SettingsExpander.Content>
            <CommunityToolkit:SettingsExpander.ItemTemplate>
                <DataTemplate>
                    <CommunityToolkit:SettingsCard Header="{Binding DisplayName}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Uid="WorldClockMoveUpButton"
                                Click="HandleMoveClockUpClicked"
                                Tag="{Binding}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                        <Setter Property="Width" Value="36" />
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Content" Value="&#xE70E;" />
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                x:Uid="WorldClockMoveDownButton"
                                Click="HandleMoveClockDownClicked"
                                Tag="{Binding}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                        <Setter Property="Width" Value="36" />
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Content" Value="&#xE70D;" />
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                x:Uid="WorldClockRemoveButton"
                                Click="HandleRemoveClockClicked"
                                Tag="{Binding}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                        <Setter Property="Width" Value="36" />
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Content" Value="&#xE74D;" />
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </CommunityToolkit:SettingsCard>
                </DataTemplate>
            </CommunityToolkit:SettingsExpander.ItemTemplate>
        </CommunityToolkit:SettingsExpander>
    </Grid>
</UserControl>
