<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GlancePresenceIconBrush" Color="#FF63E6BE" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF63E6BE" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E663E6BE" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CC63E6BE" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlancePresenceIconBrush" Color="#FF006C50" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF006C50" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E6006C50" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CC006C50" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="GlancePresenceIconBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="SystemColorButtonFaceColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
