<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Torrents.WinUI.TorrentSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="12">
        <StackPanel Spacing="4">
            <CommunityToolkit:SettingsCard
                Header="Download location"
                Description="{Binding DownloadPath, Mode=OneWay}">
                <Button
                    MinWidth="132"
                    Click="ChooseFolderClicked"
                    Content="Choose folder" />
            </CommunityToolkit:SettingsCard>
            <InfoBar
                IsClosable="False"
                IsOpen="{Binding HasDownloadPathValidationError, Mode=OneWay}"
                Message="{Binding DownloadPathValidationMessage, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>

        <StackPanel Spacing="4">
            <CommunityToolkit:SettingsExpander
                Header="Transfer limits"
                Description="Control bandwidth and peer connections. 0 means unlimited or the safe default."
                IsExpanded="True">
                <CommunityToolkit:SettingsExpander.Items>
                    <CommunityToolkit:SettingsCard
                        Header="Maximum download speed"
                        Description="Kilobytes per second. 0 means unlimited.">
                        <NumberBox
                            Width="160"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding MaximumDownloadKilobytesPerSecond, Mode=TwoWay}" />
                    </CommunityToolkit:SettingsCard>
                    <CommunityToolkit:SettingsCard
                        Header="Maximum upload speed"
                        Description="Kilobytes per second. 0 means unlimited.">
                        <NumberBox
                            Width="160"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding MaximumUploadKilobytesPerSecond, Mode=TwoWay}" />
                    </CommunityToolkit:SettingsCard>
                    <CommunityToolkit:SettingsCard
                        Header="Connections per download"
                        Description="0 uses MonoTorrent's safe default.">
                        <NumberBox
                            Width="160"
                            Maximum="10000"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding MaximumPeersPerTorrent, Mode=TwoWay}" />
                    </CommunityToolkit:SettingsCard>
                </CommunityToolkit:SettingsExpander.Items>
            </CommunityToolkit:SettingsExpander>
            <InfoBar
                IsClosable="False"
                IsOpen="{Binding HasTransferValidationError, Mode=OneWay}"
                Message="{Binding TransferValidationMessage, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>

        <StackPanel Spacing="4">
            <CommunityToolkit:SettingsExpander
                Header="Seeding"
                Description="Choose whether and when completed downloads stop uploading."
                IsExpanded="True">
                <CommunityToolkit:SettingsExpander.Items>
                    <CommunityToolkit:SettingsCard
                        Header="Continue seeding"
                        Description="Keep uploading completed downloads.">
                        <ToggleSwitch IsOn="{Binding ContinueSeeding, Mode=TwoWay}" />
                    </CommunityToolkit:SettingsCard>
                    <CommunityToolkit:SettingsCard
                        Header="Share ratio limit"
                        Description="0 disables this limit."
                        IsEnabled="{Binding ContinueSeeding, Mode=OneWay}">
                        <NumberBox
                            Width="160"
                            Minimum="0"
                            SmallChange="0.1"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding SeedingRatioLimit, Mode=TwoWay}" />
                    </CommunityToolkit:SettingsCard>
                    <CommunityToolkit:SettingsCard
                        Header="Seeding time limit"
                        Description="Minutes. 0 disables this limit."
                        IsEnabled="{Binding ContinueSeeding, Mode=OneWay}">
                        <NumberBox
                            Width="160"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding SeedingTimeLimitMinutes, Mode=TwoWay}" />
                    </CommunityToolkit:SettingsCard>
                    <CommunityToolkit:SettingsCard
                        Header="When both limits are set"
                        Description="Choose when seeding should stop."
                        IsEnabled="{Binding ContinueSeeding, Mode=OneWay}">
                        <ComboBox
                            Width="240"
                            SelectedIndex="{Binding SeedingLimitModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Stop when either limit is reached" />
                            <ComboBoxItem Content="Stop only when both limits are reached" />
                        </ComboBox>
                    </CommunityToolkit:SettingsCard>
                </CommunityToolkit:SettingsExpander.Items>
            </CommunityToolkit:SettingsExpander>
            <InfoBar
                IsClosable="False"
                IsOpen="{Binding HasSeedingValidationError, Mode=OneWay}"
                Message="{Binding SeedingValidationMessage, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>

    </StackPanel>
</UserControl>
