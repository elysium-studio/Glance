<UserControl
    x:Class="Glance.Torrents.WinUI.TorrentCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="using:Glance.UI.WinUI"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:core="using:Glance.Torrents">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Torrent.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="CompactTorrentTemplate" x:DataType="core:TorrentItemViewModel">
                <Grid Margin="2,0,0,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Controls:MarqueeTextBlock
                        Height="20"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Normal"
                        Text="{x:Bind Name, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ProgressText, Mode=OneWay}" />
                        <TextBlock Foreground="{ThemeResource GlanceTorrentDownloadBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind DownloadSpeedText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Padding="12,4" ColumnSpacing="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompactSizeStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Standard">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger
                            MinHeight="33"
                            MaxHeight="48"
                            Source="{x:Bind LayoutRoot, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="10,2" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="7" />
                        <Setter Target="StatusIndicator.Width" Value="24" />
                        <Setter Target="StatusIndicator.Height" Value="24" />
                        <Setter Target="CompactIcon.Width" Value="20" />
                        <Setter Target="CompactIcon.Height" Value="20" />
                        <Setter Target="CompactIcon.FontSize" Value="20" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger
                            MaxHeight="32"
                            Source="{x:Bind LayoutRoot, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="8,0,8,4" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="6" />
                        <Setter Target="CompactText.FontSize" Value="12" />
                        <Setter Target="CompactText.FontWeight" Value="Normal" />
                        <Setter Target="StatusIndicator.Width" Value="20" />
                        <Setter Target="StatusIndicator.Height" Value="20" />
                        <Setter Target="StatusIndicator.Margin" Value="0,1,0,-1" />
                        <Setter Target="CompactIcon.Width" Value="16" />
                        <Setter Target="CompactIcon.Height" Value="16" />
                        <Setter Target="CompactIcon.FontSize" Value="16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="StatusIndicator" Width="28" Height="28">
            <FontIcon x:Name="CompactIcon" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{ThemeResource GlanceTorrentIconBrush}" Glyph="&#xE896;" />
        </Grid>
        <Controls:MarqueeTextBlock
            x:Name="CompactText"
            Grid.Column="1"
            Height="20"
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.CompactSummary, Mode=OneWay}"
            Visibility="{x:Bind WhenEmpty(ViewModel.HasTorrents), Mode=OneWay}" />
        <Controls:CompactFlipView
            Grid.Column="1"
            Margin="-22,0,0,0"
            Background="Transparent"
            ItemTemplate="{StaticResource CompactTorrentTemplate}"
            ItemsSource="{x:Bind ViewModel.Torrents}"
            Visibility="{x:Bind WhenPopulated(ViewModel.HasTorrents), Mode=OneWay}" />
    </Grid>
</UserControl>
