<UserControl x:Class="Glance.Torrents.WinUI.TorrentExpandedView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="using:Glance.Torrents">
    <UserControl.Resources><ResourceDictionary Source="../Themes/Torrent.xaml" /></UserControl.Resources>
    <Grid Padding="24,12,24,36" Width="440" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="StatusIndicator" Width="36" Height="36"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="{ThemeResource GlanceTorrentIconBrush}" Glyph="&#xE896;" /></Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Torrent" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CompactSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12,8">
                <StackPanel><TextBlock Text="DOWNLOAD" Foreground="{ThemeResource GlanceTorrentDownloadBrush}" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.TotalDownloadSpeedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12,8">
                <StackPanel><TextBlock Text="ACTIVE" Foreground="{ThemeResource GlanceTorrentUploadBrush}" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel>
            </Border>
        </Grid>
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Torrents, Mode=OneWay}" MaxHeight="360" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:TorrentItemViewModel">
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{x:Bind ProgressText, Mode=OneWay}"/></Grid>
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind StateText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Grid.Column="1" Text="{x:Bind DownloadSpeedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Grid.Column="2" Text="{x:Bind PeerText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/></Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Pause" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanPause, Mode=OneWay}" Click="PauseClicked" />
                                <Button Content="Resume" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanResume, Mode=OneWay}" Click="ResumeClicked" />
                                <Button Content="Remove" Tag="{x:Bind Id}" Click="RemoveClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
