<UserControl
    x:Class="Glance.Infinity.WinUI.InfinityExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Infinity.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceInfinityIconBrush}"
                Glyph="&#xE8A5;" />
        </Grid>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceInfinityIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(Title)}" />
            <Grid Height="36">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ToDisplayText(ViewModel.IsConnected, ViewModel.PageTitle), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind WhenNotEditing(ViewModel.IsEditing), Mode=OneWay}" />
                <TextBox
                    Height="32"
                    VerticalAlignment="Center"
                    MaxLength="80"
                    Text="{x:Bind ViewModel.EditingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind WhenEditing(ViewModel.IsEditing), Mode=OneWay}" />
            </Grid>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToPageText(ViewModel.PageNumber), Mode=OneWay}"
                Visibility="{x:Bind ToVisibility(ViewModel.IsConnected), Mode=OneWay}" />
        </StackPanel>
        <Grid
            Grid.Column="2"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <Button
                AutomationProperties.Name="{x:Bind EditTitleLabel}"
                Click="{x:Bind ViewModel.BeginEditing}"
                ToolTipService.ToolTip="{x:Bind EditTitleLabel}"
                Visibility="{x:Bind WhenCanEdit(ViewModel.IsConnected, ViewModel.IsEditing), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Content" Value="&#xE70F;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind SaveTitleLabel}"
                Click="{x:Bind ViewModel.CommitEditAsync}"
                IsEnabled="{x:Bind IsSaveEnabled(ViewModel.IsConnected, ViewModel.IsSavingTitle), Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind SaveTitleLabel}"
                Visibility="{x:Bind WhenEditing(ViewModel.IsEditing), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Content" Value="&#xE74E;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
