<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.ScreenRecorder.WinUI.CountdownSecondsSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="CountdownSecondsSettingCard">
        <NumberBox
            Width="160"
            Minimum="0"
            Maximum="10"
            SmallChange="1"
            SpinButtonPlacementMode="Compact"
            Value="{x:Bind ViewModel.Value, Mode=TwoWay}" />
    </CommunityToolkit:SettingsCard>
</UserControl>
