<UserControl
    x:Class="Glance.ScreenRecorder.WinUI.ScreenRecorderExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:ScreenRecorder="using:Glance.ScreenRecorder">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ScreenRecorder.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="RecordingItemTemplate" x:DataType="ScreenRecorder:ScreenRecordingItemViewModel">
                <Grid Margin="2,0,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <Controls:MarqueeTextBlock
                            Height="20"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind FileName}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Detail}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button x:Uid="OpenRecordingButton" Click="{x:Bind Open}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Content" Value="&#xF5B0;" />
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                    <Setter Property="FontSize" Value="14" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Uid="RevealRecordingButton" Click="{x:Bind Reveal}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Content" Value="&#xE838;" />
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                    <Setter Property="FontSize" Value="14" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Uid="DeleteRecordingButton" Click="{x:Bind Delete}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Content" Value="&#xE74D;" />
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                    <Setter Property="FontSize" Value="14" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceScreenRecorderIconBrush}"
                Glyph="&#xE714;" />
        </Grid>
        <Grid
            x:Name="RecordingLandingTarget"
            Grid.Column="1"
            Height="58"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="22" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceScreenRecorderIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(ViewModel.Title)}" />
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind WhenEmpty(ViewModel.HasRecordings, ViewModel.IsRecording), Mode=OneWay}" />
            <TextBlock
                x:Uid="EmptyDetail"
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="{x:Bind WhenEmpty(ViewModel.HasRecordings, ViewModel.IsRecording), Mode=OneWay}" />
            <Grid
                Grid.Row="1"
                Grid.RowSpan="2"
                Visibility="{x:Bind WhenRecording(ViewModel.IsRecording), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
                <TextBlock
                    x:Uid="RecordingDetail"
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
            <Controls:CompactFlipView
                Grid.Row="1"
                Grid.RowSpan="2"
                Margin="-22,0,-12,0"
                Background="Transparent"
                ItemTemplate="{StaticResource RecordingItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Recordings}"
                SelectedItem="{x:Bind ViewModel.SelectedRecording, Mode=TwoWay}"
                Visibility="{x:Bind WhenPopulated(ViewModel.HasRecordings, ViewModel.IsRecording), Mode=OneWay}" />
        </Grid>
        <Grid
            Grid.Column="2"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Ellipse
                x:Name="PulseRing"
                Width="36"
                Height="36"
                IsHitTestVisible="False"
                Stroke="{ThemeResource GlanceScreenRecorderIconBrush}"
                StrokeThickness="1.5" />
            <Button
                x:Name="RecordButton"
                AutomationProperties.Name="{x:Bind ViewModel.Title}"
                Content="&#xE7C8;"
                IsEnabled="{x:Bind WhenCanStart(ViewModel.IsBusy, ViewModel.IsRecording), Mode=OneWay}"
                Visibility="{x:Bind WhenNotRecording(ViewModel.IsRecording), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>
                </Button.Style>
                <Button.Flyout>
                    <MenuFlyout
                        Closed="{x:Bind HandleRecordingMenuClosed}"
                        Opened="{x:Bind HandleRecordingMenuOpened}"
                        Placement="Bottom">
                        <MenuFlyoutItem Click="{x:Bind HandleRecordRegion}" Text="{x:Bind ViewModel.RecordRegionText}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF407;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="{x:Bind HandleRecordWindow}" Text="{x:Bind ViewModel.RecordWindowText}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF7ED;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="{x:Bind HandleRecordDisplay}" Text="{x:Bind ViewModel.RecordDisplayText}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind ViewModel.Title}"
                Click="{x:Bind ViewModel.ToggleRecording}"
                Content="&#xE7C8;"
                Visibility="{x:Bind WhenRecording(ViewModel.IsRecording), Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
