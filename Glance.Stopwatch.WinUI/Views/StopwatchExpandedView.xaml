<UserControl
    x:Class="Glance.Stopwatch.WinUI.StopwatchExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Stopwatch.xaml" />
    </UserControl.Resources>
    <Grid
        x:Name="LayoutRoot"
        Padding="20,12,20,26"
        ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceStopwatchIconBrush}"
                Glyph="&#xE916;" />
        </Grid>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceStopwatchIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(Title)}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Elapsed, Mode=OneWay}" />
        </StackPanel>
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <Grid Width="36" Height="36">
                <Ellipse
                    x:Name="PulseRing"
                    Width="36"
                    Height="36"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Stroke="{ThemeResource GlanceStopwatchIconBrush}"
                    StrokeThickness="1.5" />
                <Button
                    x:Uid="ToggleButton"
                    Click="{x:Bind ViewModel.Toggle}"
                    Content="{x:Bind ViewModel.ToggleGlyph, Mode=OneWay}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="18" />
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                            <Setter Property="FontSize" Value="16" />
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <Button
                x:Uid="ResetButton"
                Click="{x:Bind ViewModel.Reset}">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Content" Value="&#xE777;" />
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
