<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Glance.Shell.WinUI.SetupTourWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Tour="using:Glance.Shell.WinUI">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="SetupTourTitleBar"
            VerticalAlignment="Top">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/GlanceLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                Grid.Row="0"
                Background="{ThemeResource LayerOnAcrylicFillColorDefault}"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Padding="48">
                    <Tour:SetupWelcomeTourView
                        x:Name="WelcomePage"
                        Visibility="{x:Bind ToPageVisibility(ViewModel.CurrentPage, 0), Mode=OneWay}" />
                    <Tour:SetupExpansionTourView
                        x:Name="ExpansionPage"
                        Visibility="{x:Bind ToPageVisibility(ViewModel.CurrentPage, 1), Mode=OneWay}" />
                    <Tour:SetupPlacementTourView
                        x:Name="PlacementPage"
                        Visibility="{x:Bind ToPageVisibility(ViewModel.CurrentPage, 2), Mode=OneWay}" />
                    <Tour:SetupAutoHideTourView
                        x:Name="AutoHidePage"
                        Visibility="{x:Bind ToPageVisibility(ViewModel.CurrentPage, 3), Mode=OneWay}" />
                    <Tour:SetupModulesTourView
                        x:Name="ModulesPage"
                        Visibility="{x:Bind ToPageVisibility(ViewModel.CurrentPage, 4), Mode=OneWay}" />
                    <PipsPager
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        NextButtonVisibility="Collapsed"
                        NumberOfPages="5"
                        PreviousButtonVisibility="Collapsed"
                        SelectedPageIndex="{x:Bind ViewModel.CurrentPage, Mode=TwoWay}" />
                </Grid>
            </ScrollViewer>
            <Border
                Grid.Row="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Grid Padding="24,16" ColumnDefinitions="*,Auto">
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="BackButton"
                            x:Uid="SetupTourBackButton"
                            MinWidth="132"
                            Click="{x:Bind ViewModel.GoBack}"
                            IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
                        <Grid>
                            <Button
                                x:Name="NextButton"
                                x:Uid="SetupTourNextButton"
                                MinWidth="132"
                                Click="{x:Bind ViewModel.GoNext}"
                                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ToNextVisibility(ViewModel.IsLastPage), Mode=OneWay}" />
                            <Button
                                x:Name="FinishButton"
                                x:Uid="SetupTourFinishButton"
                                MinWidth="132"
                                Click="{x:Bind ViewModel.Finish}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ToFinishVisibility(ViewModel.IsLastPage), Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
