<Window
    x:Class="Glance.Shell.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glance.Shell.WinUI"
    xmlns:Shell="using:Glance.Shell"
    xmlns:WinUI="using:Elysium.UI.WinUI">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Loaded="HandleLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="SettingsTitleBar"
            BackRequested="HandleBackRequested"
            IsBackButtonEnabled="False"
            IsBackButtonVisible="False" />
        <NavigationView
            Grid.Row="1"
            Margin="0,8,0,0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemsSource="{x:Bind ViewModel, Mode=OneWay}"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
            SelectionChanged="HandleNavigationSelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="Shell:ISettingViewModel">
                    <NavigationViewItem Margin="8,0,0,0">
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            Content="{x:Bind}"
                            ContentTemplateSelector="{WinUI:ViewTemplateSelector}" />
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <BreadcrumbBar
                    Grid.Row="0"
                    Margin="36,0,36,16"
                    ItemClicked="HandleBreadcrumbItemClicked"
                    ItemsSource="{x:Bind BreadcrumbItems}">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="{Binding}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
                <ContentControl
                    x:Name="OverviewContent"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{x:Bind ViewModel.SelectedItem, Mode=OneWay}">
                    <ContentControl.ContentTransitions>
                        <TransitionCollection>
                            <ContentThemeTransition />
                        </TransitionCollection>
                    </ContentControl.ContentTransitions>
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="Shell:ISettingViewModel">
                            <ScrollViewer>
                                <ItemsControl
                                    Margin="36,0,36,36"
                                    ItemTemplateSelector="{WinUI:ViewTemplateSelector}"
                                    ItemsSource="{x:Bind}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <local:ModuleSettingsDetailView
                    x:Name="ModuleSettingsContent"
                    Grid.Row="1"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
