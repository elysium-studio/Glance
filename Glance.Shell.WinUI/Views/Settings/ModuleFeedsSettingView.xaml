<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.ModuleFeedsSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:Shell="using:Glance.Shell">
    <CommunityToolkit:SettingsExpander
        x:Uid="ModuleFeedsExpander"
        IsExpanded="True"
        ItemsSource="{x:Bind ViewModel.Feeds, Mode=OneWay}">
        <CommunityToolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE774;" />
        </CommunityToolkit:SettingsExpander.HeaderIcon>
        <CommunityToolkit:SettingsExpander.ItemTemplate>
            <DataTemplate x:DataType="Shell:ModuleFeedSettingItemViewModel">
                <CommunityToolkit:SettingsCard
                    Header="{x:Bind DisplayName}">
                    <CommunityToolkit:SettingsCard.Description>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind Url}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ErrorMessage}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasError, Mode=OneWay}" />
                        </StackPanel>
                    </CommunityToolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                        <Button
                            Click="HandleRemoveClick"
                            CommandParameter="{x:Bind}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="{x:Bind CanRemove, Mode=OneWay}">
                            <FontIcon Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </CommunityToolkit:SettingsCard>
            </DataTemplate>
        </CommunityToolkit:SettingsExpander.ItemTemplate>
        <CommunityToolkit:SettingsExpander.ItemsFooter>
            <StackPanel Spacing="8">
                <CommunityToolkit:SettingsCard x:Uid="AddModuleFeedCard">
                    <Grid ColumnDefinitions="240,8,Auto">
                        <TextBox
                            Grid.Column="0"
                            x:Uid="ModuleFeedAddressTextBox"
                            Text="{x:Bind ViewModel.NewFeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            x:Uid="AddModuleFeedButton"
                            MinWidth="132"
                            Click="HandleAddClick"
                            IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock x:Uid="AddModuleFeedButtonText" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </CommunityToolkit:SettingsCard>
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>
        </CommunityToolkit:SettingsExpander.ItemsFooter>
    </CommunityToolkit:SettingsExpander>
</UserControl>
