<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.ModuleFeedsSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:Shell="using:Glance.Shell">
    <CommunityToolkit:SettingsExpander
        x:Uid="ModuleFeedsExpander"
        IsExpanded="True"
        ItemsSource="{x:Bind ViewModel.Feeds, Mode=OneWay}">
        <CommunityToolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE774;" />
        </CommunityToolkit:SettingsExpander.HeaderIcon>
        <CommunityToolkit:SettingsExpander.Content>
            <Button
                x:Uid="AddModuleFeedButton"
                Click="HandleAddClick">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Content" Value="&#xE710;" />
                    </Style>
                </Button.Style>
            </Button>
        </CommunityToolkit:SettingsExpander.Content>
        <CommunityToolkit:SettingsExpander.ItemTemplate>
            <DataTemplate x:DataType="Shell:ModuleFeedSettingItemViewModel">
                <CommunityToolkit:SettingsCard
                    Header="{x:Bind DisplayName}">
                    <CommunityToolkit:SettingsCard.Description>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind Url}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ErrorMessage}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasError, Mode=OneWay}" />
                        </StackPanel>
                    </CommunityToolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                        <Button
                            x:Uid="RemoveModuleFeedButton"
                            Width="36"
                            Height="36"
                            MinWidth="36"
                            Padding="0"
                            Click="HandleRemoveClick"
                            CommandParameter="{x:Bind}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="{x:Bind CanRemove, Mode=OneWay}">
                            <FontIcon Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </CommunityToolkit:SettingsCard>
            </DataTemplate>
        </CommunityToolkit:SettingsExpander.ItemTemplate>
    </CommunityToolkit:SettingsExpander>
</UserControl>
