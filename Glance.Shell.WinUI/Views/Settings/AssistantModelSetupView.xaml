<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.AssistantModelSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls">
    <CommunityToolkit:SettingsExpander
        x:Uid="AssistantModelSetupExpander"
        IsExpanded="True">
        <CommunityToolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE720;" />
        </CommunityToolkit:SettingsExpander.HeaderIcon>
        <CommunityToolkit:SettingsExpander.Content>
            <Button
                x:Uid="SelectSpeechEngineButton"
                MinWidth="132"
                Click="HandleAddProviderClick" />
        </CommunityToolkit:SettingsExpander.Content>
        <CommunityToolkit:SettingsExpander.ItemsFooter>
            <StackPanel Spacing="8">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
                <InfoBar
                    x:Uid="AssistantModelReadyInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsSetupComplete, Mode=OneWay}"
                    Severity="Success"
                    Visibility="{x:Bind ViewModel.IsSetupComplete, Mode=OneWay}" />
                <InfoBar
                    x:Uid="AssistantProviderUnavailableInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowProviderEmptyState, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.ShowProviderEmptyState, Mode=OneWay}" />
            </StackPanel>
        </CommunityToolkit:SettingsExpander.ItemsFooter>
        <CommunityToolkit:SettingsExpander.Items>
            <CommunityToolkit:SettingsCard
                Description="{x:Bind ViewModel.InstalledProvider.Description, Mode=OneWay}"
                Header="{x:Bind ViewModel.InstalledProvider.DisplayName, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasInstalledProviders, Mode=OneWay}">
                <Button
                    x:Uid="RemoveSpeechEngineButton"
                    MinWidth="132"
                    Click="HandleRemoveProviderClick"
                    CommandParameter="{x:Bind ViewModel.InstalledProvider, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.InstalledProvider.CanRemove, Mode=OneWay}" />
            </CommunityToolkit:SettingsCard>
            <CommunityToolkit:SettingsCard
                x:Uid="AssistantModelChoiceCard"
                Description="{x:Bind ViewModel.SelectedDescription, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasModels, Mode=OneWay}">
                <ComboBox
                    Width="240"
                    DisplayMemberPath="DisplayLabel"
                    IsEnabled="{x:Bind ViewModel.CanChangeModel, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}" />
            </CommunityToolkit:SettingsCard>
            <CommunityToolkit:SettingsCard
                x:Uid="AssistantModelInstallCard"
                Description="{x:Bind ViewModel.SelectedDownloadDescription, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasModels, Mode=OneWay}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Button
                            x:Name="InstallButton"
                            MinWidth="132"
                            Click="HandleInstallClick"
                            IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowInstallButton, Mode=OneWay}">
                            <TextBlock x:Uid="AssistantModelInstallButtonText" />
                        </Button>
                        <Button
                            x:Name="CancelButton"
                            MinWidth="132"
                            Click="HandleCancelClick"
                            Visibility="{x:Bind ViewModel.ShowCancelButton, Mode=OneWay}">
                            <TextBlock x:Uid="AssistantModelCancelButtonText" />
                        </Button>
                        <Button
                            x:Name="RemoveButton"
                            MinWidth="132"
                            Click="HandleRemoveClick"
                            IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowRemoveButton, Mode=OneWay}">
                            <TextBlock x:Uid="AssistantModelRemoveButtonText" />
                        </Button>
                    </Grid>
                    <ProgressBar
                        Grid.Row="1"
                        IsHitTestVisible="False"
                        Maximum="100"
                        Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>
            </CommunityToolkit:SettingsCard>
        </CommunityToolkit:SettingsExpander.Items>
    </CommunityToolkit:SettingsExpander>
</UserControl>
