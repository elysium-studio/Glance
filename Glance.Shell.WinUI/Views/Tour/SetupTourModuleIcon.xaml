<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.SetupTourModuleIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Ellipse
            x:Name="AccentPlate"
            Opacity="0.14" />
        <FontIcon
            x:Name="GlyphIcon"
            FontSize="20" />
        <ContentPresenter
            x:Name="CustomIconPresenter"
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</UserControl>
