<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.SetupModulesTourView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Shell="using:Glance.Shell"
    xmlns:Tour="using:Glance.Shell.WinUI"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <StackPanel
        MaxWidth="680"
        HorizontalAlignment="Center"
        Spacing="16">
        <StackPanel Spacing="8">
            <TextBlock
                x:Uid="SetupModulesTitle"
                Style="{StaticResource TitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Uid="SetupModulesDescription"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <InfoBar
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsModuleFeedStatusOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ModuleFeedStatusMessage, Mode=OneWay}"
            Severity="Warning" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="Shell:SetupTourModuleCategoryViewModel">
                    <StackPanel Margin="0,0,0,20" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Glyph="{x:Bind Glyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind DisplayName}" />
                        </StackPanel>
                        <GridView
                            IsItemClickEnabled="False"
                            ItemsSource="{x:Bind}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="Shell:SetupTourModuleViewModel">
                                    <Border
                                        Width="326"
                                        Height="144"
                                        Padding="16"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="*,Auto">
                                            <Grid
                                                Width="44"
                                                Height="44">
                                                <Tour:SetupTourModuleIcon ViewModel="{x:Bind}" />
                                            </Grid>
                                            <StackPanel
                                                Grid.Column="2"
                                                Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="2"
                                                    Text="{x:Bind Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <ProgressRing
                                                    Width="20"
                                                    Height="20"
                                                    IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                    Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                                <Button
                                                    x:Uid="SetupTourAddModuleButton"
                                                    MinWidth="132"
                                                    Click="HandleInstallClicked"
                                                    IsEnabled="{x:Bind CanAdd, Mode=OneWay}"
                                                    Visibility="{x:Bind ShowAddAction, Mode=OneWay}" />
                                                <Button
                                                    x:Uid="SetupTourRemoveModuleButton"
                                                    MinWidth="132"
                                                    Click="HandleRemoveClicked"
                                                    IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                                    Visibility="{x:Bind ShowRemoveAction, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
