<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.SetupModulesTourView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Shell="using:Glance.Shell"
    xmlns:Tour="using:Glance.Shell.WinUI"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Center"
    VerticalContentAlignment="Top">
    <UserControl.Resources>
        <Tour:ModuleAccentBrushConverter x:Key="ModuleAccentBrushConverter" />
    </UserControl.Resources>
    <StackPanel
        MaxWidth="600"
        HorizontalAlignment="Center"
        Spacing="12">
        <Grid Height="300">
            <Ellipse
                x:Name="AmbientGlowOne"
                Width="300"
                Height="300"
                Margin="-220,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0.28">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#552EC4F1" />
                        <GradientStop Offset="1" Color="#002EC4F1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                x:Name="AmbientGlowTwo"
                Width="280"
                Height="280"
                Margin="240,-10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0.24">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#55F45BD0" />
                        <GradientStop Offset="1" Color="#00F45BD0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <FlipView
                x:Name="ModuleCarousel"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ItemsSource="{x:Bind ViewModel.Modules, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedModuleIndex, Mode=TwoWay}"
                SelectionChanged="HandleSelectionChanged">
                <FlipView.ItemTemplate>
                    <DataTemplate x:DataType="Shell:SetupTourModuleViewModel">
                        <Grid
                            Width="560"
                            Height="280"
                            PointerEntered="HandleCardPointerEntered"
                            PointerExited="HandleCardPointerExited">
                            <Ellipse
                                Width="260"
                                Height="260"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{Binding Converter={StaticResource ModuleAccentBrushConverter}}"
                                IsHitTestVisible="False"
                                Opacity="0.1" />
                            <Border
                                x:Name="ModuleCard"
                                Margin="22,12"
                                Padding="28"
                                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                                <Grid ColumnDefinitions="Auto,24,*" RowDefinitions="*,Auto">
                                    <Grid
                                        Width="112"
                                        Height="112"
                                        VerticalAlignment="Center">
                                        <Ellipse
                                            Fill="{Binding Converter={StaticResource ModuleAccentBrushConverter}}"
                                            Opacity="0.16" />
                                        <Ellipse
                                            Width="78"
                                            Height="78"
                                            Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            Opacity="0.9" />
                                        <FontIcon
                                            FontFamily="{x:Bind GlyphFontFamily}"
                                            FontSize="36"
                                            Foreground="{Binding Converter={StaticResource ModuleAccentBrushConverter}}"
                                            Glyph="{x:Bind Glyph}" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Converter={StaticResource ModuleAccentBrushConverter}}"
                                            Text="{x:Bind CategoryDisplayName}"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            Text="{x:Bind DisplayName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            MaxWidth="320"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="3"
                                            Text="{x:Bind Description}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border
                                        Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Margin="0,18,0,0"
                                        Padding="14,10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock
                                                x:Uid="SetupModuleEnabledLabel"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <ToggleSwitch
                                                Grid.Column="1"
                                                x:Uid="BooleanToggle"
                                                IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>
        </Grid>
        <StackPanel HorizontalAlignment="Center" Spacing="2">
            <PipsPager
                HorizontalAlignment="Center"
                MaxVisiblePips="9"
                NextButtonVisibility="Collapsed"
                NumberOfPages="{x:Bind ViewModel.Modules.Count, Mode=OneTime}"
                PreviousButtonVisibility="Collapsed"
                SelectedPageIndex="{x:Bind ViewModel.SelectedModuleIndex, Mode=TwoWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ModulePosition, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Margin="0,4,0,0" Spacing="8">
            <TextBlock
                x:Uid="SetupModulesTitle"
                Style="{StaticResource TitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Uid="SetupModulesDescription"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
