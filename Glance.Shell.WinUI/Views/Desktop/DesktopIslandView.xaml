<Controls:DesktopIsland
    x:Class="Glance.Shell.WinUI.DesktopIslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ApplicationAbstractions="using:Glance.Application.Abstractions"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:Local="using:Glance.Shell.WinUI"
    xmlns:WinUI="using:Elysium.UI.WinUI"
    CompactHeight="52"
    CompactWidth="{x:Bind ToCompactWidth(ViewModel.Assistant.IsAvailable), Mode=OneWay}"
    AllowDrop="True"
    BackgroundContent="{x:Bind ToBackgroundContent(ViewModel.SelectedComponent), Mode=OneWay}"
    DataContext="{WinUI:ViewModel Key=DesktopIslandView}"
    DragEnter="{x:Bind HandleDragEnter}"
    DragLeave="{x:Bind HandleDragLeave}"
    DragOver="{x:Bind HandleDragOver}"
    Drop="{x:Bind HandleDrop}"
    IsAutoHideEnabled="{x:Bind ViewModel.AutoHide, Mode=OneWay}"
    IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}"
    IsOpen="{x:Bind ViewModel.IsOpen, Mode=TwoWay}"
    IsTabStop="False"
    Placement="{x:Bind ToPlacement(ViewModel.PlacementIndex), Mode=OneWay}"
    PointerEntered="{x:Bind HandleIslandPointerEntered}"
    PointerExited="{x:Bind HandleIslandPointerExited}"
    PointerWheelChanged="{x:Bind HandlePointerWheelChanged}">
    <Controls:DesktopIsland.Resources>
        <x:Double x:Key="GlanceModuleReorderItemWidth">164</x:Double>
        <Local:GlanceIntentAccentBrushConverter x:Key="GlanceIntentAccentBrushConverter" />
        <Local:GlanceModuleAccentBrushConverter x:Key="GlanceModuleAccentBrushConverter" />
        <Local:UppercaseTextConverter x:Key="UppercaseTextConverter" />
        <StaticResource x:Key="GlanceDefaultAssistantIndicatorForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
        <SolidColorBrush x:Key="GlanceFooterDividerBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="GlanceFooterForegroundBrush" Color="#FFF8FAFC" />
    </Controls:DesktopIsland.Resources>
    <Controls:DesktopIsland.CompactContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter
                x:Name="CompactPresenter"
                Content="{x:Bind ViewModel.SelectedComponent.CompactContent, Mode=OneWay}" />
            <ContentControl
                x:Name="CompactAssistantIndicator"
                Grid.Column="1"
                Margin="4,0,8,0"
                VerticalAlignment="Center"
                Content="{x:Bind ViewModel.Assistant.CompactIndicatorContent, Mode=OneWay}"
                Foreground="{StaticResource GlanceDefaultAssistantIndicatorForegroundBrush}"
                Visibility="{x:Bind WhenAvailable(ViewModel.Assistant.IsAvailable), Mode=OneWay}" />
        </Grid>
    </Controls:DesktopIsland.CompactContent>
    <Controls:DesktopIsland.ExpandedContent>
        <Grid>
            <Grid
                x:Name="ExpandedModuleSurface"
                Visibility="Visible">
                <ContentPresenter
                    x:Name="ExpandedPresenter"
                    Content="{x:Bind ViewModel.SelectedComponent.ExpandedContent, Mode=OneWay}" />
                <StackPanel
                    x:Name="Footer"
                    Height="24"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="6">
                    <PipsPager
                        x:Name="ComponentPager"
                        Height="24"
                        Foreground="{StaticResource GlanceFooterForegroundBrush}"
                        IsEnabled="{x:Bind ViewModel.HasMultipleComponents, Mode=OneWay}"
                        MaxVisiblePips="5"
                        NextButtonVisibility="VisibleOnPointerOver"
                        NumberOfPages="{x:Bind ViewModel.ComponentCount, Mode=OneWay}"
                        PreviousButtonVisibility="VisibleOnPointerOver"
                        SelectedPageIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}">
                        <PipsPager.Resources>
                            <StaticResource x:Key="PipsPagerNavigationButtonForeground" ResourceKey="GlanceFooterForegroundBrush" />
                            <StaticResource x:Key="PipsPagerNavigationButtonForegroundDisabled" ResourceKey="GlanceFooterForegroundBrush" />
                            <StaticResource x:Key="PipsPagerNavigationButtonForegroundPointerOver" ResourceKey="GlanceFooterForegroundBrush" />
                            <StaticResource x:Key="PipsPagerNavigationButtonForegroundPressed" ResourceKey="GlanceFooterForegroundBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForeground" ResourceKey="GlanceFooterForegroundBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForegroundDisabled" ResourceKey="GlanceFooterForegroundBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForegroundPointerOver" ResourceKey="GlanceFooterForegroundBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForegroundPressed" ResourceKey="GlanceFooterForegroundBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForegroundSelected" ResourceKey="GlanceFooterForegroundBrush" />
                        </PipsPager.Resources>
                    </PipsPager>
                    <Border
                        Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        Background="{StaticResource GlanceFooterDividerBrush}" />
                    <Button
                        x:Uid="PinIslandButton"
                        VerticalAlignment="Center"
                        Click="{x:Bind ViewModel.TogglePinned}"
                        Visibility="{x:Bind WhenNotPinned(ViewModel.IsPinned), Mode=OneWay}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Content" Value="&#xE718;" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource GlanceFooterForegroundBrush}" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <ContentControl
                        x:Name="ExpandedAssistantIndicator"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Content="{x:Bind ViewModel.Assistant.ExpandedIndicatorContent, Mode=OneWay}"
                        Foreground="{StaticResource GlanceFooterForegroundBrush}"
                        Visibility="{x:Bind WhenAvailable(ViewModel.Assistant.IsAvailable), Mode=OneWay}" />
                    <Button
                        x:Uid="UnpinIslandButton"
                        VerticalAlignment="Center"
                        Click="{x:Bind ViewModel.TogglePinned}"
                        Visibility="{x:Bind WhenPinned(ViewModel.IsPinned), Mode=OneWay}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Content" Value="&#xE77A;" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource GlanceFooterForegroundBrush}" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        x:Uid="ReorderModulesButton"
                        VerticalAlignment="Center"
                        Click="{x:Bind ViewModel.BeginModuleReorder}"
                        Visibility="{x:Bind WhenAvailable(ViewModel.HasMultipleComponents), Mode=OneWay}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Content" Value="&#xE8A9;" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource GlanceFooterForegroundBrush}" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        x:Uid="SettingsButton"
                        VerticalAlignment="Center"
                        Click="{x:Bind ViewModel.NavigateToSettings}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Content" Value="&#xE713;" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource GlanceFooterForegroundBrush}" />
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid
                x:Name="ModuleReorderSurface"
                Padding="10,6"
                Background="Transparent"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        x:Uid="CancelModuleReorderButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="{x:Bind ViewModel.CancelModuleReorder}"
                        Content="&#xE711;"
                        CornerRadius="15"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Style="{StaticResource SubtleButtonStyle}" />
                    <Button
                        x:Uid="ConfirmModuleReorderButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Click="{x:Bind ViewModel.ConfirmModuleReorder}"
                        Content="&#xE73E;"
                        CornerRadius="15"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <Grid Margin="14,0,14,2">
                    <Grid x:Name="ModuleReorderListClipHost">
                        <ListView
                        x:Name="ModuleReorderList"
                        AllowDrop="True"
                        Background="Transparent"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragOver="HandleModuleReorderDragOver"
                        DragStarting="HandleModuleReorderDragStartingVisual"
                        DragItemsCompleted="HandleModuleReorderDragCompleted"
                        DragItemsStarting="HandleModuleReorderDragStarting"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.ModuleOrder, Mode=OneWay}"
                        Loaded="HandleModuleReorderListLoaded"
                        SelectionMode="None"
                        ShowsScrollingPlaceholders="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel
                                CacheLength="16"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Width" Value="{StaticResource GlanceModuleReorderItemWidth}" />
                            <Setter Property="Height" Value="66" />
                            <Setter Property="Margin" Value="1,0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="ApplicationAbstractions:IGlanceComponent">
                            <Border
                                Margin="2"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="12,7"
                                PointerEntered="HandleModuleOrderItemPointerEntered"
                                PointerExited="HandleModuleOrderItemPointerExited"
                                ToolTipService.ToolTip="{x:Bind DisplayName}">
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{x:Bind IconFontFamily}"
                                        FontSize="20"
                                        Foreground="{Binding Converter={StaticResource GlanceModuleAccentBrushConverter}}"
                                        Glyph="{x:Bind IconGlyph}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Converter={StaticResource GlanceModuleAccentBrushConverter}}"
                                            Text="{Binding DisplayName, Converter={StaticResource UppercaseTextConverter}}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <StackPanel Spacing="3">
                                            <Border
                                                Width="42"
                                                Height="3"
                                                HorizontalAlignment="Left"
                                                Background="{Binding Converter={StaticResource GlanceModuleAccentBrushConverter}}"
                                                CornerRadius="1.5"
                                                Opacity="0.5" />
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <Border
                                                    Width="22"
                                                    Height="3"
                                                    Background="{Binding Converter={StaticResource GlanceModuleAccentBrushConverter}}"
                                                    CornerRadius="1.5"
                                                    Opacity="0.28" />
                                                <Border
                                                    Width="10"
                                                    Height="3"
                                                    Background="{Binding Converter={StaticResource GlanceModuleAccentBrushConverter}}"
                                                    CornerRadius="1.5"
                                                    Opacity="0.28" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid
                                        Grid.Column="2"
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center">
                                        <Ellipse
                                            Fill="{Binding Converter={StaticResource GlanceModuleAccentBrushConverter}}"
                                            Opacity="0.16" />
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Fill="{Binding Converter={StaticResource GlanceModuleAccentBrushConverter}}"
                                            Opacity="0.8" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid
                        x:Name="ModuleReorderEdgeFadeHost"
                        IsHitTestVisible="False"
                        SizeChanged="HandleModuleReorderEdgeFadeHostSizeChanged" />
                </Grid>
                <Button
                    x:Name="PreviousModuleOrderButton"
                    Grid.RowSpan="2"
                    Width="14"
                    Height="38"
                    Margin="-6,0,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="HandlePreviousModuleOrderClicked"
                    Content="&#xE76B;"
                    CornerRadius="4"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="9"
                    IsEnabled="False"
                    Style="{StaticResource SubtleButtonStyle}" />
                <Button
                    x:Name="NextModuleOrderButton"
                    Grid.RowSpan="2"
                    Width="14"
                    Height="38"
                    Margin="0,0,-6,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="HandleNextModuleOrderClicked"
                    Content="&#xE76C;"
                    CornerRadius="4"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="9"
                    IsEnabled="False"
                    Style="{StaticResource SubtleButtonStyle}" />
            </Grid>
            <ContentControl
                x:Name="AssistantOverlayPresenter"
                HorizontalContentAlignment="Stretch"
                IsHitTestVisible="False"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.Assistant.OverlayContent, Mode=OneWay}"
                Visibility="Collapsed" />
            <Grid
                x:Name="ContentRoutePicker"
                Canvas.ZIndex="2"
                Padding="12"
                Background="Transparent"
                Visibility="Collapsed">
                <ItemsControl
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.ContentRoutes, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="96"
                                Height="64"
                                Padding="6"
                                AllowDrop="True"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                DragEnter="HandleContentRouteDragEnter"
                                DragLeave="HandleContentRouteDragLeave"
                                DragOver="HandleContentRouteDragOver"
                                ToolTipService.ToolTip="{Binding Description}"
                                Drop="HandleContentRouteDrop">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <FontIcon
                                        FontFamily="{Binding GlyphFontFamily}"
                                        FontSize="22"
                                        Foreground="{Binding Converter={StaticResource GlanceIntentAccentBrushConverter}}"
                                        Glyph="{Binding Glyph}" />
                                    <TextBlock
                                        MaxWidth="84"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Converter={StaticResource GlanceIntentAccentBrushConverter}}"
                                        Text="{Binding DisplayName}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Controls:DesktopIsland.ExpandedContent>
</Controls:DesktopIsland>
