<Controls:DesktopIsland
    x:Class="Glance.Shell.WinUI.DesktopIslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:WinUI="using:Elysium.UI.WinUI"
    CompactHeight="52"
    CompactWidth="{x:Bind ToCompactWidth(ViewModel.Assistant.IsAvailable), Mode=OneWay}"
    AllowDrop="True"
    BackgroundContent="{x:Bind ToBackgroundContent(ViewModel.SelectedComponent), Mode=OneWay}"
    DataContext="{WinUI:ViewModel Key=DesktopIslandView}"
    DragEnter="{x:Bind HandleDragEnter}"
    DragLeave="{x:Bind HandleDragLeave}"
    DragOver="{x:Bind HandleDragOver}"
    Drop="{x:Bind HandleDrop}"
    IsAutoHideEnabled="{x:Bind ViewModel.AutoHide, Mode=OneWay}"
    IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}"
    IsOpen="{x:Bind ViewModel.IsOpen, Mode=TwoWay}"
    IsTabStop="False"
    Placement="{x:Bind ToPlacement(ViewModel.PlacementIndex), Mode=OneWay}"
    PointerEntered="{x:Bind HandleIslandPointerEntered}"
    PointerExited="{x:Bind HandleIslandPointerExited}"
    PointerWheelChanged="{x:Bind HandlePointerWheelChanged}">
    <Controls:DesktopIsland.CompactContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter
                x:Name="CompactPresenter"
                Content="{x:Bind ViewModel.SelectedComponent.CompactContent, Mode=OneWay}" />
            <ContentControl
                x:Name="CompactAssistantIndicator"
                Grid.Column="1"
                Margin="4,0,4,0"
                VerticalAlignment="Center"
                Content="{x:Bind ViewModel.Assistant.CompactIndicatorContent, Mode=OneWay}"
                Visibility="{x:Bind WhenAvailable(ViewModel.Assistant.IsAvailable), Mode=OneWay}" />
        </Grid>
    </Controls:DesktopIsland.CompactContent>
    <Controls:DesktopIsland.ExpandedContent>
        <Grid>
            <ContentPresenter
                x:Name="ExpandedPresenter"
                Content="{x:Bind ViewModel.SelectedComponent.ExpandedContent, Mode=OneWay}" />
            <StackPanel
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="6">
                <PipsPager
                    Height="24"
                    IsEnabled="{x:Bind ViewModel.HasMultipleComponents, Mode=OneWay}"
                    MaxVisiblePips="5"
                    NextButtonVisibility="VisibleOnPointerOver"
                    NumberOfPages="{x:Bind ViewModel.ComponentCount, Mode=OneWay}"
                    PreviousButtonVisibility="VisibleOnPointerOver"
                    SelectedPageIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}" />
                <Border
                    Width="1"
                    Height="12"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button
                    x:Uid="PinIslandButton"
                    VerticalAlignment="Center"
                    Click="{x:Bind ViewModel.TogglePinned}"
                    Visibility="{x:Bind WhenNotPinned(ViewModel.IsPinned), Mode=OneWay}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                            <Setter Property="Width" Value="24" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Content" Value="&#xE718;" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </Button.Style>
                </Button>
                <ContentControl
                    x:Name="ExpandedAssistantIndicator"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Content="{x:Bind ViewModel.Assistant.ExpandedIndicatorContent, Mode=OneWay}"
                    Visibility="{x:Bind WhenAvailable(ViewModel.Assistant.IsAvailable), Mode=OneWay}" />
                <Button
                    x:Uid="UnpinIslandButton"
                    VerticalAlignment="Center"
                    Click="{x:Bind ViewModel.TogglePinned}"
                    Visibility="{x:Bind WhenPinned(ViewModel.IsPinned), Mode=OneWay}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                            <Setter Property="Width" Value="24" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Content" Value="&#xE77A;" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    x:Uid="SettingsButton"
                    VerticalAlignment="Center"
                    Click="{x:Bind ViewModel.NavigateToSettings}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                            <Setter Property="Width" Value="24" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Content" Value="&#xE713;" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <ContentControl
                x:Name="AssistantOverlayPresenter"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.Assistant.OverlayContent, Mode=OneWay}"
                Visibility="{x:Bind WhenAvailable(ViewModel.Assistant.IsOverlayVisible), Mode=OneWay}" />
        </Grid>
    </Controls:DesktopIsland.ExpandedContent>
</Controls:DesktopIsland>
