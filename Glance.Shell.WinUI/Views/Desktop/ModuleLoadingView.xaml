<UserControl
    x:Class="Glance.Shell.WinUI.ModuleLoadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Grid Background="Transparent">
        <Grid
            Padding="12,4"
            ColumnSpacing="8"
            Visibility="{x:Bind WhenCompact(IsExpanded), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="CompactIconPlaceholder"
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                CornerRadius="4" />
            <Border
                x:Name="CompactTextPlaceholder"
                Grid.Column="1"
                Width="132"
                Height="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                CornerRadius="4" />
        </Grid>

        <Grid
            Padding="20,12,20,26"
            ColumnSpacing="18"
            Visibility="{x:Bind WhenExpanded(IsExpanded), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="ExpandedIconPlaceholder"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                CornerRadius="4" />
            <Grid
                Grid.Column="1"
                Height="58"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="14" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="ExpandedTitlePlaceholder"
                    Width="64"
                    Height="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                    CornerRadius="4" />
                <Border
                    x:Name="ExpandedPrimaryPlaceholder"
                    Grid.Row="1"
                    Width="156"
                    Height="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                    CornerRadius="4" />
                <Border
                    x:Name="ExpandedSubtitlePlaceholder"
                    Grid.Row="2"
                    Width="112"
                    Height="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                    CornerRadius="4" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
