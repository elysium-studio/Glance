<UserControl
    x:Class="Glance.Shell.WinUI.ModuleLoadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="using:Glance.UI.WinUI"
    IsHitTestVisible="False">
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompactSizeStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Standard">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger
                            MinHeight="33"
                            MaxHeight="48"
                            Source="{x:Bind LayoutRoot, Mode=OneTime}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CompactLayout.Padding" Value="10,2" />
                        <Setter Target="CompactLayout.ColumnSpacing" Value="7" />
                        <Setter Target="CompactIconPlaceholder.Width" Value="20" />
                        <Setter Target="CompactIconPlaceholder.Height" Value="20" />
                        <Setter Target="CompactTextPlaceholder.Width" Value="120" />
                        <Setter Target="CompactTextPlaceholder.Height" Value="8" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger
                            MaxHeight="32"
                            Source="{x:Bind LayoutRoot, Mode=OneTime}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CompactLayout.Padding" Value="8,0,8,4" />
                        <Setter Target="CompactLayout.ColumnSpacing" Value="6" />
                        <Setter Target="CompactIconPlaceholder.Width" Value="16" />
                        <Setter Target="CompactIconPlaceholder.Height" Value="16" />
                        <Setter Target="CompactIconPlaceholder.Margin" Value="0,1,0,-1" />
                        <Setter Target="CompactIconPlaceholder.CornerRadius" Value="3" />
                        <Setter Target="CompactTextPlaceholder.Width" Value="104" />
                        <Setter Target="CompactTextPlaceholder.Height" Value="6" />
                        <Setter Target="CompactTextPlaceholder.CornerRadius" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid
            x:Name="CompactLayout"
            Padding="12,4"
            ColumnSpacing="8"
            Visibility="{x:Bind WhenCompact(IsExpanded), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="CompactIconPlaceholder"
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                CornerRadius="4" />
            <Border
                x:Name="CompactTextPlaceholder"
                Grid.Column="1"
                Width="132"
                Height="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                CornerRadius="4" />
        </Grid>

        <Grid Visibility="{x:Bind WhenExpanded(IsExpanded), Mode=OneWay}">
            <Grid
                Padding="20,12,20,26"
                ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="ExpandedIconPlaceholder"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                    CornerRadius="4" />
                <Grid
                    Grid.Column="1"
                    Height="58"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="14" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="18" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="ExpandedTitlePlaceholder"
                        Width="64"
                        Height="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4" />
                    <Border
                        x:Name="ExpandedPrimaryPlaceholder"
                        Grid.Row="1"
                        Width="156"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4" />
                    <Border
                        x:Name="ExpandedSubtitlePlaceholder"
                        Grid.Row="2"
                        Width="112"
                        Height="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4" />
                </Grid>
            </Grid>
            <StackPanel
                Height="24"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="6">
                <Grid Height="24">
                    <PipsPager
                        Height="24"
                        IsHitTestVisible="False"
                        MaxVisiblePips="5"
                        NextButtonVisibility="VisibleOnPointerOver"
                        NumberOfPages="5"
                        Opacity="0"
                        PreviousButtonVisibility="VisibleOnPointerOver" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Border
                            x:Name="ExpandedPagerPlaceholder1"
                            Width="5"
                            Height="5"
                            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            x:Name="ExpandedPagerPlaceholder2"
                            Width="5"
                            Height="5"
                            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            x:Name="ExpandedPagerPlaceholder3"
                            Width="5"
                            Height="5"
                            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            x:Name="ExpandedPagerPlaceholder4"
                            Width="5"
                            Height="5"
                            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            x:Name="ExpandedPagerPlaceholder5"
                            Width="5"
                            Height="5"
                            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                            CornerRadius="3" />
                    </StackPanel>
                </Grid>
                <Border
                    Width="1"
                    Height="12"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}" />
                <Grid Width="24" Height="24">
                    <Border
                        x:Name="ExpandedActionPlaceholder1"
                        Width="14"
                        Height="14"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4" />
                </Grid>
                <Grid Width="24" Height="24">
                    <Border
                        x:Name="ExpandedActionPlaceholder2"
                        Width="14"
                        Height="14"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4" />
                </Grid>
                <Grid Width="24" Height="24">
                    <Border
                        x:Name="ExpandedActionPlaceholder3"
                        Width="14"
                        Height="14"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4" />
                </Grid>
                <Grid Width="24" Height="24">
                    <Border
                        x:Name="ExpandedActionPlaceholder4"
                        Width="14"
                        Height="14"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4" />
                </Grid>
                <Grid Width="24" Height="24">
                    <Border
                        x:Name="ExpandedActionPlaceholder5"
                        Width="14"
                        Height="14"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
