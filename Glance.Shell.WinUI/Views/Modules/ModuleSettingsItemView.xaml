<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.ModuleSettingsItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid>
        <CommunityToolkit:SettingsCard
            Click="{x:Bind ViewModel.NavigateToSettings}"
            Description="{x:Bind ViewModel.Description}"
            Header="{x:Bind ViewModel.DisplayName}"
            IsClickEnabled="{x:Bind ViewModel.CanExpand, Mode=OneWay}">
            <CommunityToolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xEC8F;" />
            </CommunityToolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch AutomationProperties.Name="{x:Bind ViewModel.DisplayName}" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
        </CommunityToolkit:SettingsCard>
        <Border
            Width="40"
            Height="40"
            Margin="12,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="Transparent"
            Canvas.ZIndex="1"
            IsHitTestVisible="True" />
    </Grid>
</UserControl>
