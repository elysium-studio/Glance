<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.ModuleSettingsItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:Local="using:Glance.Shell.WinUI"
    Loaded="{x:Bind HandleLoaded}"
    Unloaded="{x:Bind HandleUnloaded}">
    <UserControl.Resources>
        <Local:GlanceModuleAccentBrushConverter x:Key="GlanceModuleAccentBrushConverter" />
    </UserControl.Resources>
    <CommunityToolkit:SettingsCard
        x:Name="SettingsCard"
        Click="{x:Bind ViewModel.NavigateToSettings}"
        Description="{x:Bind ViewModel.Description}"
        Header="{x:Bind ViewModel.DisplayName}"
        IsClickEnabled="{x:Bind ViewModel.CanExpand, Mode=OneWay}">
        <CommunityToolkit:SettingsCard.HeaderIcon>
            <FontIcon
                FontFamily="{x:Bind ViewModel.IconFontFamily}"
                Foreground="{x:Bind ViewModel, Converter={StaticResource GlanceModuleAccentBrushConverter}}"
                Glyph="{x:Bind ViewModel.IconGlyph}" />
        </CommunityToolkit:SettingsCard.HeaderIcon>
        <StackPanel
            Margin="{x:Bind GetToggleMargin(ViewModel.CanExpand), Mode=OneWay}"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <ToggleSwitch
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind ViewModel.DisplayName}"
                IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
            <Button
                x:Name="UninstallButton"
                x:Uid="UninstallModuleButton"
                Width="32"
                Height="32"
                MinWidth="32"
                Padding="0"
                VerticalAlignment="Center"
                Click="HandleUninstallClicked"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind GetUninstallVisibility(ViewModel.CanUninstall), Mode=OneWay}">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE74D;" />
            </Button>
        </StackPanel>
    </CommunityToolkit:SettingsCard>
</UserControl>
