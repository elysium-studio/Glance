<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.ModuleAttentionSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls">
    <CommunityToolkit:SettingsCard x:Uid="ModuleAttentionSettingCard">
        <CommunityToolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xEA8F;" />
        </CommunityToolkit:SettingsCard.HeaderIcon>
        <ToggleSwitch
            x:Uid="BooleanToggle"
            IsOn="{x:Bind ViewModel.Value, Mode=TwoWay}" />
    </CommunityToolkit:SettingsCard>
</UserControl>
