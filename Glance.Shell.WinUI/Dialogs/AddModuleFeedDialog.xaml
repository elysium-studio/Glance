<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Glance.Shell.WinUI.AddModuleFeedDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="AddModuleFeedDialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
    PrimaryButtonClick="HandlePrimaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">
    <StackPanel Width="420" Spacing="8">
        <TextBox
            x:Uid="ModuleFeedAddressTextBox"
            Text="{x:Bind ViewModel.NewFeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasAddressValidationError, Mode=OneWay}"
            Message="{x:Bind ViewModel.AddressValidationMessage, Mode=OneWay}"
            Severity="Error" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </StackPanel>
</ContentDialog>
