<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Shell.WinUI.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image
            Grid.Row="0"
            Width="120"
            Height="120"
            HorizontalAlignment="Center"
            Source="ms-appx:///Assets/GlanceLogo.png" />
        <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            FontSize="22"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.Title}" />
        <TextBlock
            Grid.Row="4"
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Version}" />
        <TextBlock
            Grid.Row="6"
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Copyright}" />
        <HyperlinkButton
            Grid.Row="8"
            HorizontalAlignment="Center"
            Content="elysiumstud.io"
            NavigateUri="{x:Bind ViewModel.WebsiteUri}" />
    </Grid>
</UserControl>
