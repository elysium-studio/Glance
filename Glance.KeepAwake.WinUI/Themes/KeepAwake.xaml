<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GlanceKeepAwakeIconBrush" Color="#FFFFB86B" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFFFB86B" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E6FFB86B" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CCFFB86B" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlanceKeepAwakeIconBrush" Color="#FF8A4600" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF8A4600" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E68A4600" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CC8A4600" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="GlanceKeepAwakeIconBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="SystemColorButtonFaceColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
