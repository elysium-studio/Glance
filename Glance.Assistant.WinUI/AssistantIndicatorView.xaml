<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Assistant.WinUI.AssistantIndicatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="32" Height="32">
        <Border
            x:Name="ListeningRing"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1.5"
            CornerRadius="16"
            IsHitTestVisible="False"
            Opacity="0" />
        <Button
            x:Name="ToggleButton"
            Width="28"
            Height="28"
            Padding="0"
            AutomationProperties.Name="Toggle voice assistant"
            Click="HandleClick"
            ToolTipService.ToolTip="Toggle voice assistant">
            <Button.Style>
                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="14" />
                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
