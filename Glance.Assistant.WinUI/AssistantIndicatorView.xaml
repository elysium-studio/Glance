<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Name="Root"
    x:Class="Glance.Assistant.WinUI.AssistantIndicatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid
            x:Name="CompactSurface"
            Width="28"
            Height="28">
            <Ellipse
                x:Name="PulseRing"
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="1"
                Stroke="{Binding Foreground, ElementName=Root, Mode=OneWay}"
                StrokeThickness="1.5" />
            <Button
                x:Name="CompactToggleButton"
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="0"
                AutomationProperties.Name="Toggle voice assistant"
                Click="HandleClick"
                Foreground="{Binding Foreground, ElementName=Root, Mode=OneWay}"
                ToolTipService.ToolTip="Toggle voice assistant">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                    </Style>
                </Button.Style>
                <FontIcon
                    x:Name="CompactGlyph"
                    Margin="-1,0,1,0"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="15" />
            </Button>
        </Grid>
        <Button
            x:Name="ExpandedToggleButton"
            Width="24"
            Height="24"
            Padding="0"
            AutomationProperties.Name="Toggle voice assistant"
            Click="HandleClick"
            Foreground="{Binding Foreground, ElementName=Root, Mode=OneWay}"
            ToolTipService.ToolTip="Toggle voice assistant">
            <Button.Style>
                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Button.Style>
            <FontIcon
                x:Name="ExpandedGlyph"
                FontFamily="Segoe Fluent Icons"
                FontSize="13" />
        </Button>
    </Grid>
</UserControl>
