<UserControl
    x:Class="Glance.Network.WinUI.NetworkAdapterExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Network.xaml" />
    </UserControl.Resources>
    <Grid Padding="24,12,24,36" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="StatusIndicator" Width="36" Height="36" VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceNetworkIconBrush}"
                Glyph="&#xE839;" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceNetworkIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(Title)}" />
            <TextBlock
                x:Uid="NoNetworkAdaptersText"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Visibility="{x:Bind WhenEmpty(ViewModel.HasAdapter), Mode=OneWay}" />
            <StackPanel Spacing="4" Visibility="{x:Bind WhenPopulated(ViewModel.HasAdapter), Mode=OneWay}">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentAdapterName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentAdapterDetail, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </StackPanel>
        <Button
            x:Name="OpenNetworkSettingsButton"
            x:Uid="OpenNetworkSettingsButton"
            Grid.Column="2"
            Width="32"
            Height="32"
            Padding="0"
            VerticalAlignment="Center"
            Click="HandleOpenNetworkSettingsClicked"
            Style="{StaticResource SubtleButtonStyle}">
            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE713;" />
        </Button>
    </Grid>
</UserControl>
