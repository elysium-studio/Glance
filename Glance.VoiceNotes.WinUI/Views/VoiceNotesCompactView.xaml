<UserControl
    x:Class="Glance.VoiceNotes.WinUI.VoiceNotesCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VoiceNotes="using:Glance.VoiceNotes.WinUI">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/VoiceNotes.xaml" />
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Padding="12,4" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="28"
            Height="28">
            <FontIcon
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="24"
                Foreground="{ThemeResource GlanceVoiceNotesIconBrush}"
                Glyph="&#xE720;" />
        </Grid>
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.CompactStatusText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <VoiceNotes:VoiceWaveform
            Grid.Column="2"
            Height="18"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            BarCount="24"
            ViewModel="{x:Bind ViewModel}"
            Visibility="{x:Bind ToRecordingVisibility(ViewModel.IsRecording), Mode=OneWay}" />
    </Grid>
</UserControl>
