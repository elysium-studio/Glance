<UserControl
    x:Class="Glance.ScreenLens.WinUI.ScreenLensExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/ScreenLens.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <Viewbox
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <PathIcon
                    Width="24"
                    Height="24"
                    Foreground="{ThemeResource GlanceScreenLensIconBrush}"
                    Style="{StaticResource GlanceScreenLensPathIconStyle}" />
            </Viewbox>
        </Grid>
        <Grid
            Grid.Column="1"
            Height="58"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="22" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceScreenLensIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(ViewModel.Title)}" />
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                MaxLines="1"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Uid="LauncherDetail"
                Grid.Row="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>
        <Button
            x:Name="ExtractButton"
            x:Uid="ExtractButton"
            Grid.Column="2"
            VerticalAlignment="Center"
            Click="{x:Bind ViewModel.Extract}"
            IsEnabled="{x:Bind WhenIdle(ViewModel.IsExtracting), Mode=OneWay}">
            <Button.Style>
                <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="18" />
                </Style>
            </Button.Style>
            <Viewbox
                Width="16"
                Height="16">
                <PathIcon
                    Width="24"
                    Height="24"
                    Foreground="{x:Bind ExtractButton.Foreground, Mode=OneWay}"
                    Style="{StaticResource GlanceScreenLensPathIconStyle}" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
