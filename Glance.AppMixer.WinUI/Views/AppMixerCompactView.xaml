<UserControl
    x:Class="Glance.AppMixer.WinUI.AppMixerCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/AppMixer.xaml" />
    </UserControl.Resources>
    <Grid Padding="12,4" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="28"
            Height="28">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="23"
                Foreground="{ThemeResource GlanceAppMixerIconBrush}"
                Glyph="&#xE9E9;" />
        </Grid>
        <StackPanel
            Grid.Column="1"
            MinWidth="0"
            VerticalAlignment="Center"
            Spacing="0">
            <Controls:MarqueeTextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind ViewModel.CurrentApplicationName, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.CurrentApplicationName, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.CurrentVolumeText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid
            Grid.Column="2"
            VerticalAlignment="Center"
            Visibility="{x:Bind WhenPopulated(ViewModel.HasApplications), Mode=OneWay}">
            <Button
                x:Uid="ToggleMuteButton"
                Click="{x:Bind ViewModel.SelectedApplication.ToggleMute}"
                Content="{x:Bind ViewModel.SelectedApplication.MuteGlyph, Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="14" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="12" />
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
