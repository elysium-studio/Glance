<UserControl
    x:Class="Glance.AppMixer.WinUI.AppMixerExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AppMixer="using:Glance.AppMixer"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/AppMixer.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="AudioApplicationItemTemplate" x:DataType="AppMixer:AudioApplicationItemViewModel">
                <Grid Margin="2,0,0,0" Padding="0,0,0,3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Controls:MarqueeTextBlock
                                Height="20"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind VolumeText, Mode=OneWay}" />
                        </Grid>
                        <Grid
                            Grid.Row="1"
                            Height="32"
                            Margin="-8,0,0,0">
                            <ProgressBar
                                Height="4"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource GlanceAppMixerIconBrush}"
                                IsHitTestVisible="False"
                                Maximum="100"
                                Value="{x:Bind Volume, Mode=OneWay}" />
                            <Rectangle
                                Height="2"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource GlanceAppMixerMeterBrush}"
                                HorizontalAlignment="Stretch"
                                IsHitTestVisible="False"
                                RadiusX="1"
                                RadiusY="1"
                                RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{x:Bind PeakScale, Mode=OneWay}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Slider
                                AutomationProperties.Name="Application volume"
                                Height="32"
                                Maximum="100"
                                Minimum="0"
                                StepFrequency="1"
                                Value="{x:Bind Volume, Mode=TwoWay}">
                                <Slider.Resources>
                                    <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                </Slider.Resources>
                            </Slider>
                        </Grid>
                    </Grid>
                    <Button
                        x:Uid="ToggleMuteButton"
                        Grid.Column="1"
                        Click="{x:Bind ToggleMute}"
                        Content="{x:Bind MuteGlyph, Mode=OneWay}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                <Setter Property="Width" Value="32" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                <Setter Property="FontSize" Value="14" />
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceAppMixerIconBrush}"
                Glyph="&#xE9E9;" />
        </Grid>
        <Grid
            Grid.Column="1"
            Height="68"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceAppMixerIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(Title)}" />
            <StackPanel
                Grid.Row="1"
                VerticalAlignment="Center"
                Spacing="1"
                Visibility="{x:Bind WhenEmpty(ViewModel.HasApplications), Mode=OneWay}">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentApplicationName, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentVolumeText, Mode=OneWay}" />
            </StackPanel>
            <Controls:CompactFlipView
                Grid.Row="1"
                Margin="-22,0,0,0"
                Background="Transparent"
                ItemTemplate="{StaticResource AudioApplicationItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Applications}"
                SelectedItem="{x:Bind ViewModel.SelectedApplication, Mode=TwoWay}"
                Visibility="{x:Bind WhenPopulated(ViewModel.HasApplications), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
