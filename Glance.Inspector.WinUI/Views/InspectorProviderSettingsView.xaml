<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Inspector.WinUI.InspectorProviderSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls">
    <CommunityToolkit:SettingsExpander x:Uid="ProviderSettingsExpander" IsExpanded="True" ItemsSource="{x:Bind ViewModel.Providers}">
        <CommunityToolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE721;" />
        </CommunityToolkit:SettingsExpander.HeaderIcon>
        <CommunityToolkit:SettingsExpander.Content>
            <Button x:Uid="ProviderAddButton" Click="HandleAddClicked" IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock x:Uid="ProviderAddButtonLabel" />
                </StackPanel>
            </Button>
        </CommunityToolkit:SettingsExpander.Content>
        <CommunityToolkit:SettingsExpander.ItemsFooter>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="ProviderEmptyText" Margin="16,8" Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />
                <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Severity="{x:Bind GetStatusSeverity(ViewModel.IsStatusError), Mode=OneWay}" />
            </StackPanel>
        </CommunityToolkit:SettingsExpander.ItemsFooter>
        <CommunityToolkit:SettingsExpander.ItemTemplate>
            <DataTemplate>
                <CommunityToolkit:SettingsCard Header="{Binding DisplayName}" Description="{Binding Description}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:Uid="ProviderEnabledToggle" IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                        <Button x:Uid="ProviderRemoveButton" Width="32" Height="32" MinWidth="32" Padding="0" VerticalAlignment="Center" Click="HandleRemoveClicked" IsEnabled="{Binding CanRemove}" Style="{StaticResource SubtleButtonStyle}" Tag="{Binding}">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </CommunityToolkit:SettingsCard>
            </DataTemplate>
        </CommunityToolkit:SettingsExpander.ItemTemplate>
    </CommunityToolkit:SettingsExpander>
</UserControl>
