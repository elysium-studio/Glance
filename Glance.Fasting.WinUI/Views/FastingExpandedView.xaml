<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Fasting.WinUI.FastingExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Fasting.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{StaticResource GlanceFastingAccentBrush}"
                Glyph="&#xE916;" />
        </Grid>
        <Grid
            Grid.Column="1"
            Height="58"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="22" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{StaticResource GlanceFastingAccentBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(ViewModel.Title)}" />
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Foreground="{StaticResource GlanceFastingForegroundBrush}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Foreground="{StaticResource GlanceFastingSecondaryForegroundBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Uid="ResetButton"
                Width="32"
                Height="32"
                Padding="0"
                Command="{x:Bind ViewModel.ResetSessionCommand}"
                CornerRadius="16"
                IsEnabled="{x:Bind IsResetEnabled(ViewModel.Status), Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE777;" />
            </Button>
            <Grid Width="36" Height="36">
                <Ellipse
                    x:Name="PulseRing"
                    Width="36"
                    Height="36"
                    IsHitTestVisible="False"
                    Stroke="{StaticResource GlanceFastingAccentBrush}"
                    StrokeThickness="1.5" />
                <Button
                    x:Uid="ToggleButton"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleSessionCommand}"
                    Content="{x:Bind ViewModel.ToggleGlyph, Mode=OneWay}"
                    CornerRadius="18"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
