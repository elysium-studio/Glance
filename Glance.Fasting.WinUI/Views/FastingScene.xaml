<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Fasting.WinUI.FastingScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Loaded="{x:Bind HandleLoaded}"
    Unloaded="{x:Bind HandleUnloaded}">
    <Grid x:Name="SceneRoot" Background="#FF17142D">
        <Border x:Name="NightLayer">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FF16132E" />
                    <GradientStop Offset="0.55" Color="#FF25204B" />
                    <GradientStop Offset="1" Color="#FF101E3B" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="DawnLayer" Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF532548" />
                    <GradientStop Offset="0.52" Color="#FF713849" />
                    <GradientStop Offset="1" Color="#FF1F3155" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="CompletionLayer" Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF724123" />
                    <GradientStop Offset="0.55" Color="#FF664249" />
                    <GradientStop Offset="1" Color="#FF25375D" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Canvas>
            <Ellipse
                x:Name="OrbitRing"
                Width="420"
                Height="190"
                Canvas.Left="-16"
                Canvas.Top="34"
                Opacity="0.18"
                Stroke="#FFFFDCA0"
                StrokeThickness="1" />
            <Ellipse
                x:Name="GlowOrb"
                Width="112"
                Height="112"
                Canvas.Left="8"
                Canvas.Top="82"
                Fill="#33FFD485" />
            <Ellipse
                x:Name="ProgressOrb"
                Width="48"
                Height="48"
                Canvas.Left="40"
                Canvas.Top="114"
                Fill="#CCFFD485" />
            <Ellipse Width="3" Height="3" Canvas.Left="74" Canvas.Top="28" Fill="#99FFFFFF" />
            <Ellipse Width="2" Height="2" Canvas.Left="158" Canvas.Top="48" Fill="#77FFFFFF" />
            <Ellipse Width="3" Height="3" Canvas.Left="274" Canvas.Top="32" Fill="#88FFFFFF" />
            <Ellipse Width="2" Height="2" Canvas.Left="348" Canvas.Top="66" Fill="#77FFFFFF" />
        </Canvas>
        <Ellipse
            x:Name="CompletionRing"
            Width="70"
            Height="70"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0"
            Stroke="#CCFFE4B5"
            StrokeThickness="2" />
    </Grid>
</UserControl>
