<UserControl
    x:Class="Glance.Stash.WinUI.StashExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:Stash="using:Glance.Stash">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Stash.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="StashItemTemplate" x:DataType="Stash:StashItem">
                <Grid
                    Margin="2,0,0,0"
                    CanDrag="True"
                    ColumnSpacing="8"
                    DragStarting="HandleItemDragStarting">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        VerticalAlignment="Center"
                        Spacing="1"
                        ToolTipService.ToolTip="{x:Bind Content}">
                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind DisplayText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Detail}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Uid="CopyButton"
                            Click="{x:Bind Copy}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                                    <Setter Property="Content" Value="&#xE8C8;" />
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                    <Setter Property="FontSize" Value="14" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            x:Name="OpenButton"
                            x:Uid="OpenButton"
                            Click="{x:Bind Open}"
                            x:Load="{x:Bind CanOpen}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                                    <Setter Property="Content" Value="&#xE8A7;" />
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                    <Setter Property="FontSize" Value="14" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            x:Name="OpenInEditorButton"
                            x:Uid="OpenInEditorButton"
                            Click="{x:Bind OpenInEditor}"
                            x:Load="{x:Bind CanOpenInEditor}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                                    <Setter Property="Content" Value="&#xE70F;" />
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                    <Setter Property="FontSize" Value="14" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            x:Uid="RemoveButton"
                            Click="{x:Bind Remove}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                                    <Setter Property="Content" Value="&#xE74D;" />
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                    <Setter Property="FontSize" Value="14" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <FontIcon
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="30"
                Foreground="{ThemeResource GlanceStashIconBrush}"
                Glyph="&#xE718;" />
        </Grid>
        <Grid
            Grid.Column="1"
            Height="58"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="22" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceStashIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(ViewModel.Title)}" />
            <TextBlock
                x:Uid="EmptyMessage"
                Grid.Row="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind WhenEmpty(ViewModel.HasItems), Mode=OneWay}" />
            <TextBlock
                x:Uid="EmptyDetail"
                Grid.Row="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind WhenEmpty(ViewModel.HasItems), Mode=OneWay}" />
            <Controls:CompactFlipView
                x:Name="StashFlipView"
                Grid.Row="1"
                Grid.RowSpan="2"
                Margin="-22,0,0,0"
                Background="Transparent"
                ItemTemplate="{StaticResource StashItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                Visibility="{x:Bind WhenPopulated(ViewModel.HasItems), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
