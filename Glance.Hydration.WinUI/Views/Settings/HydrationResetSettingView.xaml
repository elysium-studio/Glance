<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Hydration.WinUI.HydrationResetSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls">
    <CommunityToolkit:SettingsCard x:Uid="ResetDaySettingCard">
        <CommunityToolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE777;" />
        </CommunityToolkit:SettingsCard.HeaderIcon>
        <Button
            x:Uid="ResetDayButton"
            MinWidth="132"
            Click="{x:Bind ViewModel.Reset}"
            IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}" />
    </CommunityToolkit:SettingsCard>
</UserControl>
