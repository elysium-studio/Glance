<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Hydration.WinUI.HydrationScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Loaded="{x:Bind HandleLoaded}"
    Unloaded="{x:Bind HandleUnloaded}">
    <Border x:Name="SceneRoot" Background="#FF10253D">
        <Grid x:Name="SceneClip">
            <Grid x:Name="WaterLayer">
                <Canvas>
                    <Path
                        x:Name="BackWave"
                        Width="840"
                        Height="190"
                        Canvas.Left="-60"
                        Data="M0,16 C20,4 40,4 60,16 C80,28 100,28 120,16 C140,4 160,4 180,16 C200,28 220,28 240,16 C260,4 280,4 300,16 C320,28 340,28 360,16 C380,4 400,4 420,16 C440,28 460,28 480,16 C500,4 520,4 540,16 C560,28 580,28 600,16 C620,4 640,4 660,16 C680,28 700,28 720,16 C740,4 760,4 780,16 C800,28 820,28 840,16 L840,190 L0,190 Z"
                        Fill="#995EC9E8" />
                    <Path
                        x:Name="FrontWave"
                        Width="840"
                        Height="190"
                        Data="M0,16 C20,28 40,28 60,16 C80,4 100,4 120,16 C140,28 160,28 180,16 C200,4 220,4 240,16 C260,28 280,28 300,16 C320,4 340,4 360,16 C380,28 400,28 420,16 C440,4 460,4 480,16 C500,28 520,28 540,16 C560,4 580,4 600,16 C620,28 640,28 660,16 C680,4 700,4 720,16 C740,28 760,28 780,16 C800,4 820,4 840,16 L840,190 L0,190 Z"
                        Fill="#D929A8D1" />
                </Canvas>
            </Grid>
            <Ellipse
                x:Name="CompletionRipple"
                Width="80"
                Height="80"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0"
                Stroke="#B3E8FAFF"
                StrokeThickness="2" />
        </Grid>
    </Border>
</UserControl>
