<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Hydration.WinUI.HydrationExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Hydration.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,26" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="36"
            Height="36"
            VerticalAlignment="Center">
            <Path
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M11.4697 2.21967C11.7626 1.92678 12.2374 1.92678 12.5303 2.21967C12.9334 2.62274 14.5286 4.34735 16.0289 6.58192C17.5084 8.78544 19 11.6349 19 14.25C19 16.7736 18.2536 18.7287 16.9556 20.0557C15.6588 21.3814 13.8894 22 12 22C10.1106 22 8.34122 21.3814 7.04444 20.0557C5.7464 18.7287 5 16.7736 5 14.25C5 11.6349 6.49158 8.78544 7.97108 6.58192C9.47144 4.34735 11.0666 2.62274 11.4697 2.21967Z"
                Fill="{StaticResource GlanceHydrationAccentBrush}"
                Stretch="Uniform" />
        </Grid>
        <Grid
            Grid.Column="1"
            Height="58"
            VerticalAlignment="Center"
            RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="22" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{StaticResource GlanceHydrationAccentBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ToUpper(ViewModel.Title)}" />
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Foreground="{StaticResource GlanceHydrationForegroundBrush}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Foreground="{StaticResource GlanceHydrationSecondaryForegroundBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Uid="UndoButton"
                Width="32"
                Height="32"
                Padding="0"
                Command="{x:Bind ViewModel.UndoLastDrinkCommand}"
                CornerRadius="16"
                IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Glyph="&#xE7A7;" />
            </Button>
            <Button
                x:Uid="LogDrinkButton"
                Width="36"
                Height="36"
                Padding="0"
                Command="{x:Bind ViewModel.LogConfiguredDrinkCommand}"
                CornerRadius="18"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.LogDrinkLabel, Mode=OneWay}">
                <Path
                    Width="18"
                    Height="18"
                    Data="M11.4697 2.21967C11.7626 1.92678 12.2374 1.92678 12.5303 2.21967C12.9334 2.62274 14.5286 4.34735 16.0289 6.58192C17.5084 8.78544 19 11.6349 19 14.25C19 16.7736 18.2536 18.7287 16.9556 20.0557C15.6588 21.3814 13.8894 22 12 22C10.1106 22 8.34122 21.3814 7.04444 20.0557C5.7464 18.7287 5 16.7736 5 14.25C5 11.6349 6.49158 8.78544 7.97108 6.58192C9.47144 4.34735 11.0666 2.62274 11.4697 2.21967Z"
                    Fill="{StaticResource GlanceHydrationOnAccentBrush}"
                    Stretch="Uniform" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
