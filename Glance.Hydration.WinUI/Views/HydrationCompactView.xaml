<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Hydration.WinUI.HydrationCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="using:Glance.UI.WinUI">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Hydration.xaml" />
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Padding="14,8" ColumnSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompactSizeStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Standard">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger MinHeight="33" MaxHeight="48" Source="{x:Bind LayoutRoot, Mode=OneTime}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="10,2" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="7" />
                        <Setter Target="StatusIndicator.Width" Value="24" />
                        <Setter Target="StatusIndicator.Height" Value="24" />
                        <Setter Target="CompactIcon.Width" Value="20" />
                        <Setter Target="CompactIcon.Height" Value="20" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger MaxHeight="32" Source="{x:Bind LayoutRoot, Mode=OneTime}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="8,0,8,4" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="6" />
                        <Setter Target="CompactText.FontSize" Value="12" />
                        <Setter Target="CompactText.FontWeight" Value="Normal" />
                        <Setter Target="StatusIndicator.Width" Value="20" />
                        <Setter Target="StatusIndicator.Height" Value="20" />
                        <Setter Target="StatusIndicator.Margin" Value="0,1,0,-1" />
                        <Setter Target="CompactIcon.Width" Value="16" />
                        <Setter Target="CompactIcon.Height" Value="16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="28"
            Height="28">
            <Path
                x:Name="CompactIcon"
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M11.4697 2.21967C11.7626 1.92678 12.2374 1.92678 12.5303 2.21967C12.9334 2.62274 14.5286 4.34735 16.0289 6.58192C17.5084 8.78544 19 11.6349 19 14.25C19 16.7736 18.2536 18.7287 16.9556 20.0557C15.6588 21.3814 13.8894 22 12 22C10.1106 22 8.34122 21.3814 7.04444 20.0557C5.7464 18.7287 5 16.7736 5 14.25C5 11.6349 6.49158 8.78544 7.97108 6.58192C9.47144 4.34735 11.0666 2.62274 11.4697 2.21967Z"
                Fill="{StaticResource GlanceHydrationAccentBrush}"
                Stretch="Uniform" />
        </Grid>
        <TextBlock
            x:Name="CompactText"
            Grid.Column="1"
            VerticalAlignment="Center"
            Foreground="{StaticResource GlanceHydrationForegroundBrush}"
            MaxLines="1"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.CompactText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
