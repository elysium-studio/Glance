<UserControl
    x:Class="Glance.RemovableDevices.WinUI.RemovableDevicesCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="using:Glance.UI.WinUI">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/RemovableDevices.xaml" />
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Padding="12,4" ColumnSpacing="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompactSizeStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Standard">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger
                            MinHeight="33"
                            MaxHeight="48"
                            Source="{x:Bind LayoutRoot, Mode=OneTime}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="10,2" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="7" />
                        <Setter Target="StatusIndicator.Width" Value="24" />
                        <Setter Target="StatusIndicator.Height" Value="24" />
                        <Setter Target="CompactIcon.Width" Value="20" />
                        <Setter Target="CompactIcon.Height" Value="20" />
                        <Setter Target="CompactIcon.FontSize" Value="20" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger
                            MaxHeight="32"
                            Source="{x:Bind LayoutRoot, Mode=OneTime}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="8,0,8,4" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="6" />
                        <Setter Target="EmptyStatusText.FontSize" Value="12" />
                        <Setter Target="EmptyStatusText.FontWeight" Value="Normal" />
                        <Setter Target="DeviceStatusText.FontSize" Value="12" />
                        <Setter Target="DeviceStatusText.FontWeight" Value="Normal" />
                        <Setter Target="StatusIndicator.Width" Value="20" />
                        <Setter Target="StatusIndicator.Height" Value="20" />
                        <Setter Target="StatusIndicator.Margin" Value="0,1,0,-1" />
                        <Setter Target="CompactIcon.Width" Value="16" />
                        <Setter Target="CompactIcon.Height" Value="16" />
                        <Setter Target="CompactIcon.FontSize" Value="16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="StatusIndicator"
            Width="28"
            Height="28">
            <FontIcon
                x:Name="CompactIcon"
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="24"
                Foreground="{ThemeResource GlanceRemovableDevicesIconBrush}"
                Glyph="&#xE88E;" />
        </Grid>
        <TextBlock
            x:Name="EmptyStatusText"
            Grid.Column="1"
            VerticalAlignment="Center"
            MaxLines="1"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.CompactStatusText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            x:Load="{x:Bind WhenEmpty(ViewModel.HasDevices), Mode=OneWay}" />
        <TextBlock
            x:Name="DeviceStatusText"
            Grid.Column="1"
            VerticalAlignment="Center"
            MaxLines="1"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.CompactStatusText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            x:Load="{x:Bind ViewModel.HasDevices, Mode=OneWay}" />
    </Grid>
</UserControl>
