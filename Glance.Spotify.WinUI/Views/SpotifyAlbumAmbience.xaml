<UserControl
    x:Class="Glance.Spotify.WinUI.SpotifyAlbumAmbience"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    ActualThemeChanged="{x:Bind HandleActualThemeChanged}"
    Loaded="{x:Bind HandleLoaded}"
    SizeChanged="{x:Bind HandleSizeChanged}"
    Unloaded="{x:Bind HandleUnloaded}">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Spotify.xaml" />
    </UserControl.Resources>
    <Border Background="Transparent">
        <Grid>
            <Grid x:Name="MotionLayer">
                <Grid x:Name="ArtworkHost" />
            </Grid>
            <Rectangle x:Name="AcrylicOverlay" Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        </Grid>
    </Border>
</UserControl>
