<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Spotify.WinUI.SpotifyCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:Local="using:Glance.Spotify.WinUI"
    xmlns:UI="using:Glance.UI.WinUI"
    Loaded="{x:Bind HandleLoaded}"
    Unloaded="{x:Bind HandleUnloaded}">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Spotify.xaml" />
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Padding="12,4" ColumnSpacing="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompactSizeStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Standard">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger MinHeight="33" MaxHeight="48" Source="{x:Bind LayoutRoot, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="10,2" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="7" />
                        <Setter Target="LogoContainer.Width" Value="22" />
                        <Setter Target="LogoContainer.Height" Value="22" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <UI:ElementSizeTrigger MaxHeight="32" Source="{x:Bind LayoutRoot, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="8,0,8,4" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="6" />
                        <Setter Target="LogoContainer.Width" Value="18" />
                        <Setter Target="LogoContainer.Height" Value="18" />
                        <Setter Target="LogoContainer.Margin" Value="0,1,0,-1" />
                        <Setter Target="TitleText.FontSize" Value="12" />
                        <Setter Target="TitleText.FontWeight" Value="Normal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Local:SpotifyLogo
            x:Name="LogoContainer"
            Width="28"
            Height="28"
            VerticalAlignment="Center" />
        <Controls:MarqueeTextBlock
            x:Name="TitleText"
            Grid.Column="1"
            Height="20"
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" />
    </Grid>
</UserControl>
