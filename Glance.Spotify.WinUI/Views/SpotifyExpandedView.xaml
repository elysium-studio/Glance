<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Glance.Spotify.WinUI.SpotifyExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:Elysium.UI.Controls.WinUI"
    xmlns:Local="using:Glance.Spotify.WinUI"
    Loaded="{x:Bind HandleLoaded}"
    Unloaded="{x:Bind HandleUnloaded}">
    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/Spotify.xaml" />
    </UserControl.Resources>
    <Grid Padding="20,12,20,26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="ArtworkContainer"
            Width="64"
            Height="64"
            VerticalAlignment="Center"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid>
                <Border
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind WhenArtworkUnavailable(ViewModel.Artwork), Mode=OneWay}">
                    <Local:SpotifyLogo
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <Local:SpotifyArtworkTransition Source="{x:Bind ToImageSource(ViewModel.Artwork), Mode=OneWay}" />
            </Grid>
        </Border>
        <Grid
            x:Name="DisconnectedContent"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Height="58"
            Margin="18,0,0,0"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasNoPlayback, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="22" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Uid="DisconnectedTitle"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlanceSpotifyIconBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                Grid.Row="2"
                Height="16"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>
        <Grid
            Grid.Column="1"
            Height="58"
            Margin="18,0,16,0"
            VerticalAlignment="Center"
            RowSpacing="1"
            Visibility="{x:Bind ViewModel.HasPlayback, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button
                x:Name="PlaybackSourceButton"
                Height="18"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="{x:Bind ToAccentColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{x:Bind ToPointerOverColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{x:Bind ToPressedColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{x:Bind ToDisabledColor(ViewModel.AccentColor), Mode=OneWay}" />
                </Button.Resources>
                <Button.Content>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxWidth="120"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ToUpper(ViewModel.PlaybackSourceName), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <FontIcon
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            FontSize="8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout
                        x:Name="PlaybackSourceFlyout"
                        Closed="{x:Bind HandlePlaybackSourceFlyoutClosed}"
                        Opened="{x:Bind HandlePlaybackSourceFlyoutOpened}"
                        Opening="HandlePlaybackSourceFlyoutOpening" />
                </Button.Flyout>
            </Button>
            <Grid Grid.Row="1" RowSpacing="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Controls:MarqueeTextBlock
                    x:Name="TitleText"
                    Height="20"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.PlaybackText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PlaybackText, Mode=OneWay}" />
                <Grid Grid.Row="1" Height="20">
                    <Grid>
                        <Rectangle
                            Height="2"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SliderTrackFill}"
                            IsHitTestVisible="False"
                            RadiusX="1"
                            RadiusY="1" />
                        <Rectangle
                            Height="4"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Fill="{x:Bind ToAccentBrush(ViewModel.AccentColor), Mode=OneWay}"
                            IsHitTestVisible="False"
                            RadiusX="2"
                            RadiusY="2"
                            RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{x:Bind ViewModel.ProgressScale, Mode=OneWay}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Slider
                            x:Name="ProgressSlider"
                            Height="20"
                            Margin="2,0,10,0"
                            AutomationProperties.Name="Playback position"
                            IsEnabled="{x:Bind ViewModel.CanControlPlayback, Mode=OneWay}"
                            Maximum="{x:Bind ViewModel.DurationMilliseconds, Mode=OneWay}"
                            Minimum="0"
                            PointerCaptureLost="HandleProgressChanged"
                            StepFrequency="1000"
                            Value="{x:Bind ViewModel.ProgressMilliseconds, Mode=OneWay}">
                            <Slider.RenderTransform>
                                <TranslateTransform Y="-2" />
                            </Slider.RenderTransform>
                            <Slider.Resources>
                                <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
                                <x:Double x:Key="SliderPreContentMargin">10</x:Double>
                                <x:Double x:Key="SliderPostContentMargin">10</x:Double>
                                <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
                                <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                                <x:Double x:Key="SliderInnerThumbWidth">10</x:Double>
                                <x:Double x:Key="SliderInnerThumbHeight">10</x:Double>
                                <CornerRadius x:Key="SliderThumbCornerRadius">8</CornerRadius>
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="{x:Bind ToAccentColor(ViewModel.AccentColor), Mode=OneWay}" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{x:Bind ToPointerOverColor(ViewModel.AccentColor), Mode=OneWay}" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{x:Bind ToPressedColor(ViewModel.AccentColor), Mode=OneWay}" />
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="5"
            Visibility="{x:Bind ViewModel.HasPlayback, Mode=OneWay}">
            <Button x:Uid="PreviousButton" Click="{x:Bind ViewModel.Previous}" IsEnabled="{x:Bind ViewModel.CanControlPlayback, Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Content" Value="&#xE622;" />
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
            <Button
                x:Uid="ToggleButton"
                Click="{x:Bind ViewModel.TogglePlayback}"
                Content="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanControlPlayback, Mode=OneWay}">
                <Button.Resources>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{x:Bind ToAccentColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{x:Bind ToPointerOverColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{x:Bind ToPressedColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{x:Bind ToDisabledColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="{x:Bind ToForegroundColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{x:Bind ToPointerOverForegroundColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{x:Bind ToPressedForegroundColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{x:Bind ToDisabledForegroundColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{x:Bind ToBorderColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{x:Bind ToPointerOverBorderColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{x:Bind ToPressedBorderColor(ViewModel.AccentColor), Mode=OneWay}" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{x:Bind ToDisabledBorderColor(ViewModel.AccentColor), Mode=OneWay}" />
                </Button.Resources>
                <Button.Style>
                    <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Uid="NextButton" Click="{x:Bind ViewModel.Next}" IsEnabled="{x:Bind ViewModel.CanControlPlayback, Mode=OneWay}">
                <Button.Style>
                    <Style BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Content" Value="&#xE623;" />
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
